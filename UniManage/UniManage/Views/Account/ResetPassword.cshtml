@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password – UniManage</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter','ui-sans-serif','system-ui','sans-serif'] } } } }</script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .fi { width:100%; padding:0.65rem 1rem; border:1.5px solid #cbd5e1; border-radius:0.5rem; font-size:0.875rem; transition:border-color 150ms,box-shadow 150ms; outline:none; background:#fff; color:#1e293b; }
        .fi:focus { border-color:#1d4ed8; box-shadow:0 0 0 3px rgba(29,78,216,0.12); }
        .fi.err { border-color:#ef4444; box-shadow:0 0 0 3px rgba(239,68,68,0.1); }
        .fe { color:#dc2626; font-size:0.72rem; margin-top:0.25rem; display:flex; align-items:center; gap:0.25rem; }
        .lbl { display:block; font-size:0.7rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#64748b; margin-bottom:0.4rem; }
        .rule { display:flex; align-items:center; gap:0.4rem; font-size:0.72rem; color:#94a3b8; }
        .rule.pass { color:#16a34a; }
    </style>
</head>
<body class="font-sans" style="background:linear-gradient(135deg,#0d1b2a 0%,#0f2042 45%,#1e3a8a 100%);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1rem;">
    <div style="width:100%;max-width:430px;">
        <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
            <!-- Header -->
            <div style="background:linear-gradient(90deg,#0f172a,#1e3a8a);padding:2rem 2rem 1.75rem;" class="flex flex-col items-center text-center">
                <div class="w-14 h-14 rounded-2xl bg-blue-600 flex items-center justify-center mb-4 shadow-lg" style="box-shadow:0 8px 24px rgba(29,78,216,0.5);">
                    <i class="fa-solid fa-lock-open text-white text-xl"></i>
                </div>
                <h1 class="text-xl text-white tracking-tight">Set New Password</h1>
                <p class="text-sm mt-1" style="color:rgba(255,255,255,0.55);">Choose a strong password</p>
            </div>

            <!-- Body -->
            <div class="px-8 py-7">
                <!-- Step indicator -->
                <div class="flex items-center gap-2 mb-6">
                    <div class="flex items-center gap-1.5">
                        <span class="w-7 h-7 rounded-full bg-emerald-500 text-white text-xs flex items-center justify-center"><i class="fa-solid fa-check text-xs"></i></span>
                        <span class="text-xs text-emerald-600 font-medium">Email</span>
                    </div>
                    <div class="flex-1 h-px bg-emerald-300"></div>
                    <div class="flex items-center gap-1.5">
                        <span class="w-7 h-7 rounded-full bg-emerald-500 text-white text-xs flex items-center justify-center"><i class="fa-solid fa-check text-xs"></i></span>
                        <span class="text-xs text-emerald-600 font-medium">OTP</span>
                    </div>
                    <div class="flex-1 h-px bg-blue-300"></div>
                    <div class="flex items-center gap-1.5">
                        <span class="w-7 h-7 rounded-full bg-blue-700 text-white text-xs font-bold flex items-center justify-center">3</span>
                        <span class="text-xs font-medium text-blue-700">Reset</span>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="mb-5 flex items-start gap-2.5 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg">
                        <i class="fa-solid fa-circle-xmark mt-0.5 flex-shrink-0"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form method="post" asp-action="ResetPassword" id="resetForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@ViewBag.Email" />

                    <div class="mb-5">
                        <label for="newPassword" class="lbl"><i class="fa-solid fa-lock mr-1"></i>New Password</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"><i class="fa-solid fa-lock"></i></span>
                            <input type="password" id="newPassword" name="newPassword" required placeholder="••••••••"
                                   class="fi" style="padding-left:2.4rem;padding-right:2.8rem;" autocomplete="new-password" />
                            <button type="button" onclick="togglePwd('newPassword','eye1')" tabindex="-1"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition-colors">
                                <i id="eye1" class="fa-solid fa-eye text-sm"></i>
                            </button>
                        </div>
                        <p id="npErr" class="fe" style="display:none;"><i class="fa-solid fa-triangle-exclamation"></i><span></span></p>

                        <!-- Strength rules -->
                        <div class="mt-2 space-y-1 pl-0.5">
                            <p class="rule" id="rule-len"><i class="fa-solid fa-circle text-xs"></i> At least 6 characters</p>
                            <p class="rule" id="rule-upper"><i class="fa-solid fa-circle text-xs"></i> One uppercase letter</p>
                            <p class="rule" id="rule-num"><i class="fa-solid fa-circle text-xs"></i> One number</p>
                        </div>
                    </div>

                    <div class="mb-7">
                        <label for="confirmPassword" class="lbl"><i class="fa-solid fa-lock mr-1"></i>Confirm Password</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"><i class="fa-solid fa-lock"></i></span>
                            <input type="password" id="confirmPassword" name="confirmPassword" required placeholder="••••••••"
                                   class="fi" style="padding-left:2.4rem;padding-right:2.8rem;" autocomplete="new-password" />
                            <button type="button" onclick="togglePwd('confirmPassword','eye2')" tabindex="-1"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition-colors">
                                <i id="eye2" class="fa-solid fa-eye text-sm"></i>
                            </button>
                        </div>
                        <p id="cpErr" class="fe" style="display:none;"><i class="fa-solid fa-triangle-exclamation"></i><span></span></p>
                    </div>

                    <button type="submit" id="resetBtn"
                            class="w-full py-3 text-white rounded-lg transition-all flex items-center justify-center gap-2 text-sm font-medium"
                            style="background:linear-gradient(90deg,#1d4ed8,#1e40af);box-shadow:0 4px 14px rgba(29,78,216,0.35);">
                        <i class="fa-solid fa-floppy-disk"></i> Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        function togglePwd(inputId, iconId) {
            var inp = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (inp.type === 'password') { inp.type = 'text'; icon.className = 'fa-solid fa-eye-slash text-sm'; }
            else { inp.type = 'password'; icon.className = 'fa-solid fa-eye text-sm'; }
        }

        // Live password rules
        document.getElementById('newPassword').addEventListener('input', function () {
            var v = this.value;
            check('rule-len', v.length >= 6);
            check('rule-upper', /[A-Z]/.test(v));
            check('rule-num', /[0-9]/.test(v));
        });

        function check(id, pass) {
            var el = document.getElementById(id);
            el.className = pass ? 'rule pass' : 'rule';
            el.querySelector('i').className = pass ? 'fa-solid fa-circle-check text-xs' : 'fa-solid fa-circle text-xs';
        }

        document.getElementById('resetForm').addEventListener('submit', function (e) {
            var ok = true;
            var np = document.getElementById('newPassword');
            var cp = document.getElementById('confirmPassword');

            function err(id, errId, msg) {
                document.getElementById(id).classList.add('err');
                var el = document.getElementById(errId);
                el.style.display = 'flex'; el.querySelector('span').textContent = msg; ok = false;
            }
            function clear(id, errId) {
                document.getElementById(id).classList.remove('err');
                document.getElementById(errId).style.display = 'none';
            }

            clear('newPassword', 'npErr'); clear('confirmPassword', 'cpErr');

            if (!np.value || np.value.length < 6) err('newPassword', 'npErr', 'Password must be at least 6 characters.');
            if (!cp.value) { err('confirmPassword', 'cpErr', 'Please confirm your password.'); }
            else if (np.value !== cp.value) { err('confirmPassword', 'cpErr', 'Passwords do not match.'); }

            if (!ok) { e.preventDefault(); return; }
            var btn = document.getElementById('resetBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Updating...';
        });
    </script>
</body>
</html>
