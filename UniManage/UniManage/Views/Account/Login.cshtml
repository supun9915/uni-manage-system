@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In – UniManage</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .fi { width:100%; padding:0.65rem 1rem; border:1.5px solid #cbd5e1; border-radius:0.5rem; font-size:0.875rem; transition:border-color 150ms,box-shadow 150ms; outline:none; background:#fff; color:#1e293b; }
        .fi:focus { border-color:#1d4ed8; box-shadow:0 0 0 3px rgba(29,78,216,0.12); }
        .fi.err { border-color:#ef4444; box-shadow:0 0 0 3px rgba(239,68,68,0.1); }
        .fe { color:#dc2626; font-size:0.72rem; margin-top:0.25rem; display:flex; align-items:center; gap:0.25rem; }
        .lbl { display:block; font-size:0.7rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#64748b; margin-bottom:0.4rem; }
    </style>
</head>
<body class="font-sans" style="background:linear-gradient(135deg,#0d1b2a 0%,#0f2042 45%,#1e3a8a 100%);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1rem;">
    <div style="width:100%;max-width:430px;">
        <!-- Card -->
        <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
            <!-- Header band -->
            <div style="background:linear-gradient(90deg,#0f172a,#1e3a8a);padding:2rem 2rem 1.75rem;" class="flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-2xl bg-blue-600 flex items-center justify-center mb-4 shadow-lg" style="box-shadow:0 8px 24px rgba(29,78,216,0.5);">
                    <i class="fa-solid fa-graduation-cap text-white text-2xl"></i>
                </div>
                <h1 class="text-2xl text-white tracking-tight">UniManage</h1>
                <p class="text-sm mt-1" style="color:rgba(255,255,255,0.55);">University Management System</p>
            </div>

            <!-- Form area -->
            <div class="px-8 py-7">
                <p class="text-base text-slate-800 mb-6 text-center">Sign in to your account</p>

                @if (TempData["Success"] != null)
                {
                    <div class="mb-5 flex items-start gap-2.5 bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm px-4 py-3 rounded-lg">
                        <i class="fa-solid fa-circle-check mt-0.5 flex-shrink-0"></i>
                        <span>@TempData["Success"]</span>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="mb-5 flex items-start gap-2.5 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg">
                        <i class="fa-solid fa-circle-xmark mt-0.5 flex-shrink-0"></i>
                        <span>@TempData["Error"]</span>
                    </div>
                }
                @if (ViewBag.Error != null)
                {
                    <div class="mb-5 flex items-start gap-2.5 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg">
                        <i class="fa-solid fa-circle-xmark mt-0.5 flex-shrink-0"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form id="loginForm" method="post" asp-action="Login" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="mb-5">
                        <label for="email" class="lbl"><i class="fa-solid fa-envelope mr-1"></i>Email Address</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"><i class="fa-solid fa-at"></i></span>
                            <input type="email" id="email" name="email" required placeholder="you@university.edu"
                                   class="fi" style="padding-left:2.4rem;" />
                        </div>
                        <p id="emailErr" class="fe" style="display:none;"><i class="fa-solid fa-triangle-exclamation"></i> <span></span></p>
                    </div>
                    <div class="mb-7">
                        <div class="flex items-center justify-between mb-[0.4rem]">
                            <label for="password" class="lbl mb-0"><i class="fa-solid fa-lock mr-1"></i>Password</label>
                            <a asp-action="ForgotPassword" class="text-xs text-blue-600 hover:text-blue-800 hover:underline">Forgot password?</a>
                        </div>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"><i class="fa-solid fa-lock"></i></span>
                            <input type="password" id="password" name="password" required placeholder="••••••••"
                                   class="fi" style="padding-left:2.4rem;padding-right:2.8rem;" />
                            <button type="button" id="pwdToggle" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition-colors" tabindex="-1">
                                <i id="pwdIcon" class="fa-solid fa-eye text-sm"></i>
                            </button>
                        </div>
                        <p id="pwdErr" class="fe" style="display:none;"><i class="fa-solid fa-triangle-exclamation"></i> <span></span></p>
                    </div>
                    <button type="submit" class="w-full py-3 text-white rounded-lg transition-all flex items-center justify-center gap-2 text-sm"
                            style="background:linear-gradient(90deg,#1d4ed8,#1e40af);box-shadow:0 4px 14px rgba(29,78,216,0.35);">
                        <i class="fa-solid fa-right-to-bracket"></i> Sign In
                    </button>
                </form>
            </div>

            <!-- Footer -->
            <div class="px-8 pb-6 text-center text-xs text-slate-400">
                <i class="fa-solid fa-shield-halved mr-1"></i> Secure login &mdash; UniManage &copy; @DateTime.Now.Year
            </div>
        </div>

        <!-- Demo hint -->
        <div class="mt-4 rounded-xl px-5 py-4 text-xs" style="background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.65);">
            <p class="mb-2 font-normal" style="color:rgba(255,255,255,0.85);"><i class="fa-solid fa-circle-info mr-1"></i>Demo Accounts</p>
            <div class="space-y-1">
                <p><span style="color:rgba(255,255,255,0.5);">Admin &nbsp;&nbsp;&nbsp;:</span> admin@unimanage.com / Admin@123</p>
                <p><span style="color:rgba(255,255,255,0.5);">Lecturer:</span> lecturer@unimanage.com / Lecturer@123</p>
                <p><span style="color:rgba(255,255,255,0.5);">Student :</span> student@unimanage.com / Student@123</p>
            </div>
        </div>
    </div>

    <script>
        // Password toggle
        document.getElementById('pwdToggle').addEventListener('click', function () {
            var inp = document.getElementById('password');
            var icon = document.getElementById('pwdIcon');
            if (inp.type === 'password') { inp.type = 'text'; icon.className = 'fa-solid fa-eye-slash text-sm'; }
            else { inp.type = 'password'; icon.className = 'fa-solid fa-eye text-sm'; }
        });
        // Client-side validation
        document.getElementById('loginForm').addEventListener('submit', function (e) {
            var ok = true;
            function validate(id, errId, msg) {
                var inp = document.getElementById(id);
                var errEl = document.getElementById(errId);
                if (!inp.value.trim()) {
                    inp.classList.add('err'); errEl.style.display = 'flex'; errEl.querySelector('span').textContent = msg; ok = false;
                } else { inp.classList.remove('err'); errEl.style.display = 'none'; }
            }
            validate('email', 'emailErr', 'Email address is required.');
            validate('password', 'pwdErr', 'Password is required.');
            if (!ok) e.preventDefault();
        });
        // Live clear on input
        ['email','password'].forEach(function(id) {
            document.getElementById(id).addEventListener('input', function() {
                this.classList.remove('err');
                var errId = id === 'email' ? 'emailErr' : 'pwdErr';
                document.getElementById(errId).style.display = 'none';
            });
        });
    </script>
</body>
</html>
