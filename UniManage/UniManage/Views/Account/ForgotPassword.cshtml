@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password – UniManage</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter','ui-sans-serif','system-ui','sans-serif'] } } } }</script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .fi { width:100%; padding:0.65rem 1rem; border:1.5px solid #cbd5e1; border-radius:0.5rem; font-size:0.875rem; transition:border-color 150ms,box-shadow 150ms; outline:none; background:#fff; color:#1e293b; }
        .fi:focus { border-color:#1d4ed8; box-shadow:0 0 0 3px rgba(29,78,216,0.12); }
        .lbl { display:block; font-size:0.7rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#64748b; margin-bottom:0.4rem; }
    </style>
</head>
<body class="font-sans" style="background:linear-gradient(135deg,#0d1b2a 0%,#0f2042 45%,#1e3a8a 100%);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1rem;">
    <div style="width:100%;max-width:430px;">
        <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
            <!-- Header -->
            <div style="background:linear-gradient(90deg,#0f172a,#1e3a8a);padding:2rem 2rem 1.75rem;" class="flex flex-col items-center text-center">
                <div class="w-14 h-14 rounded-2xl bg-blue-600 flex items-center justify-center mb-4 shadow-lg" style="box-shadow:0 8px 24px rgba(29,78,216,0.5);">
                    <i class="fa-solid fa-key text-white text-xl"></i>
                </div>
                <h1 class="text-xl text-white tracking-tight">Forgot Password</h1>
                <p class="text-sm mt-1" style="color:rgba(255,255,255,0.55);">We'll send an OTP to your email</p>
            </div>

            <!-- Body -->
            <div class="px-8 py-7">
                <!-- Step indicator -->
                <div class="flex items-center gap-2 mb-6">
                    <div class="flex items-center gap-1.5">
                        <span class="w-7 h-7 rounded-full bg-blue-700 text-white text-xs font-bold flex items-center justify-center">1</span>
                        <span class="text-xs font-medium text-blue-700">Email</span>
                    </div>
                    <div class="flex-1 h-px bg-slate-200"></div>
                    <div class="flex items-center gap-1.5">
                        <span class="w-7 h-7 rounded-full bg-slate-200 text-slate-400 text-xs font-bold flex items-center justify-center">2</span>
                        <span class="text-xs text-slate-400">OTP</span>
                    </div>
                    <div class="flex-1 h-px bg-slate-200"></div>
                    <div class="flex items-center gap-1.5">
                        <span class="w-7 h-7 rounded-full bg-slate-200 text-slate-400 text-xs font-bold flex items-center justify-center">3</span>
                        <span class="text-xs text-slate-400">Reset</span>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="mb-5 flex items-start gap-2.5 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg">
                        <i class="fa-solid fa-circle-xmark mt-0.5 flex-shrink-0"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }
                @if (ViewBag.Success != null)
                {
                    <div class="mb-5 flex items-start gap-2.5 bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm px-4 py-3 rounded-lg">
                        <i class="fa-solid fa-circle-check mt-0.5 flex-shrink-0"></i>
                        <span>@ViewBag.Success</span>
                    </div>
                }

                <p class="text-sm text-slate-500 mb-5">Enter the email address associated with your account and we'll send you a one-time password.</p>

                <form method="post" asp-action="ForgotPassword" id="fpForm" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="mb-6">
                        <label for="email" class="lbl"><i class="fa-solid fa-envelope mr-1"></i>Email Address</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"><i class="fa-solid fa-at"></i></span>
                            <input type="email" id="email" name="email" required placeholder="you@university.edu"
                                   class="fi" style="padding-left:2.4rem;" />
                        </div>
                        <p id="emailErr" class="text-red-600 text-xs mt-1 hidden"><i class="fa-solid fa-triangle-exclamation mr-1"></i><span></span></p>
                    </div>
                    <button type="submit" id="submitBtn"
                            class="w-full py-3 text-white rounded-lg transition-all flex items-center justify-center gap-2 text-sm font-medium"
                            style="background:linear-gradient(90deg,#1d4ed8,#1e40af);box-shadow:0 4px 14px rgba(29,78,216,0.35);">
                        <i class="fa-solid fa-paper-plane"></i> Send OTP
                    </button>
                </form>

                <div class="mt-5 text-center">
                    <a asp-action="Login" class="text-xs text-blue-700 hover:underline inline-flex items-center gap-1">
                        <i class="fa-solid fa-arrow-left text-xs"></i> Back to Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('fpForm').addEventListener('submit', function (e) {
            var email = document.getElementById('email');
            var errEl = document.getElementById('emailErr');
            if (!email.value.trim()) {
                email.classList.add('border-red-400');
                errEl.classList.remove('hidden');
                errEl.querySelector('span').textContent = 'Email address is required.';
                e.preventDefault();
                return;
            }
            errEl.classList.add('hidden');
            email.classList.remove('border-red-400');
            var btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
        });
    </script>
</body>
</html>
