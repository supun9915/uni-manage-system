@model IEnumerable<UniManage.Models.EnrollmentApplicationModel>
@{
    ViewData["Title"] = "My Applications";
}

<div class="page-card">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-blue-700 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-file-lines text-white text-sm"></i>
            </div>
            <div>
                <h2 class="text-sm font-semibold text-slate-800">My Enrollment Applications</h2>
                <p class="text-xs text-slate-400">Track the status of your course applications</p>
            </div>
        </div>
        <a asp-action="Browse" class="inline-flex items-center gap-1.5 text-sm bg-blue-900 text-white px-4 py-1.5 rounded-lg hover:bg-blue-800 border border-blue-700">
            <i class="fa-solid fa-magnifying-glass text-xs"></i> Browse More Courses
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-emerald-50 text-emerald-700 text-sm flex items-center gap-2">
            <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="flex flex-col items-center py-16 text-slate-400">
            <i class="fa-solid fa-file-circle-question text-4xl mb-3 opacity-30"></i>
            <p class="text-sm">You have not submitted any applications yet.</p>
            <a asp-action="Browse" class="mt-3 text-xs text-blue-600 hover:underline">Browse available courses</a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="table-header">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Course</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Document Type</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Applied</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Status</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Admin Note</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var app in Model)
                    {
                        var (bg, text) = app.Status switch
                        {
                            "approved" => ("bg-emerald-50", "text-emerald-700"),
                            "rejected" => ("bg-red-50", "text-red-700"),
                            _          => ("bg-amber-50", "text-amber-700")
                        };
                        var icon = app.Status switch
                        {
                            "approved" => "fa-circle-check",
                            "rejected" => "fa-circle-xmark",
                            _          => "fa-clock"
                        };
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 font-medium text-slate-800">
                                <div>@app.Course?.Title</div>
                                <div class="text-xs text-slate-400">@app.Course?.Department?.Name</div>
                            </td>
                            <td class="px-4 py-3 text-slate-600 text-xs">@app.DocumentType</td>
                            <td class="px-4 py-3 text-slate-400 text-xs">@app.AppliedAt.ToString("dd MMM yyyy")</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-full font-medium @bg @text">
                                    <i class="fa-solid @icon text-xs"></i>
                                    @System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(app.Status)
                                </span>
                            </td>
                            <td class="px-4 py-3 text-xs text-slate-500">@(app.AdminNote ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
