@{
    ViewData["Title"] = "Apply to Enroll";
    var course = ViewBag.Course as UniManage.Models.CourseModel;
}

<div class="page-card max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 rounded-lg bg-blue-700 flex items-center justify-center flex-shrink-0">
            <i class="fa-solid fa-paper-plane text-white text-sm"></i>
        </div>
        <div>
            <h2 class="text-sm font-semibold text-slate-800">Apply to Enroll</h2>
            <p class="text-xs text-slate-400">@course?.Title &nbsp;&middot;&nbsp; @course?.Department?.Name</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(course?.PrerequisiteCourses))
    {
        <div class="mb-5 p-3 rounded-lg bg-amber-50 border border-amber-200 text-sm text-amber-800">
            <div class="flex items-start gap-2">
                <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
                <div>
                    <div class="font-medium mb-0.5">Prerequisite Courses Required</div>
                    <div class="text-xs">@course.PrerequisiteCourses</div>
                    <div class="text-xs mt-1 opacity-75">Please upload your completion documents for the above prerequisite courses below.</div>
                </div>
            </div>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200">
            <ul class="list-disc list-inside text-xs text-red-700">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@e.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" enctype="multipart/form-data"
          asp-controller="EnrollmentApplications" asp-action="Apply" asp-route-courseId="@course?.Id">
        @Html.AntiForgeryToken()

        <div class="space-y-5">
            <!-- Document Type -->
            <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">
                    Document Type <span class="text-red-500">*</span>
                </label>
                <select name="documentType" class="form-input" required>
                    <option value="">-- Select document type --</option>
                    <option value="Transcript">Academic Transcript</option>
                    <option value="Certificate">Completion Certificate</option>
                    <option value="Grade Report">Grade Report</option>
                    <option value="Letter of Completion">Letter of Completion</option>
                    <option value="Other">Other</option>
                </select>
                <p class="text-xs text-slate-400 mt-1">Select the type of document that proves your prerequisite completion.</p>
            </div>

            <!-- File Upload -->
            <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">
                    Upload Document <span class="text-red-500">*</span>
                </label>
                <div class="border-2 border-dashed border-slate-300 rounded-lg p-6 text-center hover:border-blue-400 transition-colors cursor-pointer" onclick="document.getElementById('documentFile').click()">
                    <i class="fa-solid fa-cloud-arrow-up text-2xl text-slate-400 mb-2"></i>
                    <p class="text-sm text-slate-500">Click to upload or drag &amp; drop</p>
                    <p class="text-xs text-slate-400 mt-1">PDF, DOC, DOCX, JPG, PNG (max 50 MB)</p>
                    <p id="fileName" class="text-xs text-blue-700 mt-2 font-medium hidden"></p>
                </div>
                <input type="file" id="documentFile" name="documentFile" class="hidden"
                       accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                       onchange="document.getElementById('fileName').textContent=this.files[0]?.name; document.getElementById('fileName').classList.remove('hidden')" required />
            </div>

            <!-- Student Note -->
            <div>
                <label class="block text-xs font-medium text-slate-600 mb-1">Additional Notes <span class="text-slate-400">(optional)</span></label>
                <textarea name="studentNote" rows="3" class="form-input resize-none"
                          placeholder="Any additional information you want to share with the admin..."></textarea>
            </div>
        </div>

        <div class="flex items-center justify-between mt-6 pt-4 border-t border-slate-100">
            <a asp-controller="EnrollmentApplications" asp-action="Browse"
               class="text-sm text-slate-500 hover:text-slate-700 flex items-center gap-1">
                <i class="fa-solid fa-arrow-left text-xs"></i> Back to Courses
            </a>
            <button type="submit"
                    class="inline-flex items-center gap-2 bg-blue-900 text-white text-sm px-6 py-2 rounded-lg hover:bg-blue-800 transition-colors">
                <i class="fa-solid fa-paper-plane"></i> Submit Application
            </button>
        </div>
    </form>
</div>
