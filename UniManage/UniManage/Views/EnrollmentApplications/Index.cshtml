@model IEnumerable<UniManage.Models.EnrollmentApplicationModel>
@{
    ViewData["Title"] = "Enrollment Applications";
    var statusFilter = ViewBag.StatusFilter as string;
}

<div class="page-card">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-blue-700 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-inbox text-white text-sm"></i>
            </div>
            <div>
                <h2 class="text-sm font-semibold text-slate-800">Enrollment Applications</h2>
                <p class="text-xs text-slate-400">Review and approve student course applications</p>
            </div>
        </div>
        <!-- Status filter -->
        <form method="get" class="flex items-center gap-2">
            <select name="status" class="text-xs border border-slate-200 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-300">
                <option value="">All Statuses</option>
                <option value="pending"  selected="@(statusFilter == "pending"  ? "selected" : null)">Pending</option>
                <option value="approved" selected="@(statusFilter == "approved" ? "selected" : null)">Approved</option>
                <option value="rejected" selected="@(statusFilter == "rejected" ? "selected" : null)">Rejected</option>
            </select>
            <button type="submit" class="text-xs bg-blue-900 text-white px-3 py-1.5 rounded-lg hover:bg-blue-800">Filter</button>
            @if (!string.IsNullOrEmpty(statusFilter))
            {
                <a asp-action="Index" class="text-xs text-slate-400 hover:text-red-500">Clear</a>
            }
        </form>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-emerald-50 text-emerald-700 text-sm flex items-center gap-2">
            <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 text-red-700 text-sm flex items-center gap-2">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="flex flex-col items-center py-16 text-slate-400">
            <i class="fa-solid fa-inbox text-4xl mb-3 opacity-30"></i>
            <p class="text-sm">No applications found.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="table-header">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Student</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Course</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Doc Type</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Applied</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Status</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var app in Model)
                    {
                        var (bg, text) = app.Status switch
                        {
                            "approved" => ("bg-emerald-50", "text-emerald-700"),
                            "rejected" => ("bg-red-50", "text-red-700"),
                            _          => ("bg-amber-50", "text-amber-700")
                        };
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 font-medium text-slate-800">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-blue-700 flex items-center justify-center text-white text-xs flex-shrink-0">@(app.Student?.FirstName?[0])</div>
                                    @app.Student?.FirstName @app.Student?.LastName
                                </div>
                            </td>
                            <td class="px-4 py-3 text-slate-600 text-xs">@app.Course?.Title</td>
                            <td class="px-4 py-3 text-slate-500 text-xs">@app.DocumentType</td>
                            <td class="px-4 py-3 text-slate-400 text-xs">@app.AppliedAt.ToString("dd MMM yyyy")</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-full font-medium @bg @text">
                                    @System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(app.Status)
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                <a asp-action="Review" asp-route-id="@app.Id"
                                   class="inline-flex items-center gap-1 text-xs bg-blue-50 text-blue-700 px-3 py-1 rounded-lg hover:bg-blue-100 transition-colors">
                                    <i class="fa-solid fa-eye"></i> Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
