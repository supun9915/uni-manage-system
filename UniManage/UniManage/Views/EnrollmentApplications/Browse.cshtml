@model IEnumerable<UniManage.Models.CourseModel>
@{
    ViewData["Title"] = "Browse Courses";
    var enrolledIds = ViewBag.EnrolledCourseIds as List<int> ?? new List<int>();
    var appliedIds  = ViewBag.AppliedCourseIds  as List<int> ?? new List<int>();
    int i = 0;
}

<div class="page-card">
    <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 rounded-lg bg-blue-700 flex items-center justify-center flex-shrink-0">
            <i class="fa-solid fa-magnifying-glass text-white text-sm"></i>
        </div>
        <div>
            <h2 class="text-sm font-semibold text-slate-800">Available Courses</h2>
            <p class="text-xs text-slate-400">Browse and apply for courses</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-emerald-50 text-emerald-700 text-sm flex items-center gap-2">
            <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 text-red-700 text-sm flex items-center gap-2">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="flex flex-col items-center py-16 text-slate-400">
            <i class="fa-solid fa-book-open text-4xl mb-3 opacity-30"></i>
            <p class="text-sm">No courses available at the moment.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var course in Model)
            {
                i++;
                bool enrolled = enrolledIds.Contains(course.Id);
                bool applied  = appliedIds.Contains(course.Id);
                var initial = string.IsNullOrWhiteSpace(course.Title) ? "?" : course.Title.Split(' ')[0];

                <div class="group bg-white rounded-2xl border border-slate-100 overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200"
                     data-dept="@(course.Department?.Name?.ToLower())">

                    <!-- Coloured top band -->
                    <div class="h-24 bg-blue-50 relative flex items-center px-5 gap-4 border-b border-blue-100">
                        <div class="w-12 h-12 rounded-xl bg-blue-900 flex items-center justify-center text-white text-lg font-bold flex-shrink-0 shadow-sm">
                            @initial
                        </div>
                        <div class="overflow-hidden">
                            <p class="text-slate-500 text-[0.65rem] uppercase tracking-widest font-semibold">@course.Code</p>
                            <h3 class="text-slate-500 text-sm font-bold leading-tight line-clamp-2">@course.Title</h3>
                        </div>
                        <span class="absolute top-3 right-3 text-[0.65rem] font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700 border border-emerald-200 capitalize">
                            <i class="fa-solid fa-circle-check mr-1"></i>published
                        </span>
                    </div>

                    <!-- Card body -->
                    <div class="p-4">
                        <div class="flex items-center gap-1.5 text-xs text-slate-400 mb-2">
                            <i class="fa-solid fa-building text-slate-300"></i>
                            <span>@(course.Department?.Name ?? "No Department")</span>
                        </div>
                        <p class="text-xs text-slate-500 line-clamp-2 min-h-[2.5rem] leading-relaxed">
                            @(string.IsNullOrWhiteSpace(course.Description) ? "No description provided." : course.Description)
                        </p>
                        @if (!string.IsNullOrEmpty(course.PrerequisiteCourses))
                        {
                            <div class="mt-2 p-2 rounded-lg bg-amber-50 border border-amber-200 text-xs text-amber-700">
                                <i class="fa-solid fa-triangle-exclamation mr-1"></i>
                                <span class="font-medium">Prerequisites:</span> @course.PrerequisiteCourses
                            </div>
                        }

                        <!-- Footer actions -->
                        <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-100">
                            @if (enrolled)
                            {
                                <span class="inline-flex items-center gap-1 text-xs bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-lg font-medium">
                                    <i class="fa-solid fa-circle-check"></i> Enrolled
                                </span>
                            }
                            else if (applied)
                            {
                                <span class="inline-flex items-center gap-1 text-xs bg-amber-50 text-amber-700 px-3 py-1.5 rounded-lg font-medium">
                                    <i class="fa-solid fa-clock"></i> Application Pending
                                </span>
                            }
                            else
                            {
                                <a asp-controller="EnrollmentApplications" asp-action="Apply" asp-route-courseId="@course.Id"
                                   class="inline-flex items-center gap-1.5 text-xs bg-blue-900 text-white px-4 py-1.5 rounded-lg hover:bg-blue-800 transition-colors font-medium">
                                    <i class="fa-solid fa-paper-plane"></i> Apply to Enroll
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
