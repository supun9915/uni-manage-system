@{
    ViewData["Title"] = "Admin Dashboard";
    int totalUsers        = ViewBag.TotalUsers        ?? 0;
    int totalCourses      = ViewBag.TotalCourses      ?? 0;
    int totalStudents     = ViewBag.TotalStudents     ?? 0;
    int totalEnrollments  = ViewBag.TotalEnrollments  ?? 0;
    int totalLecturers    = ViewBag.TotalLecturers    ?? 0;
    int totalAdmins       = ViewBag.TotalAdmins       ?? 0;
    int totalDepartments  = ViewBag.TotalDepartments  ?? 0;
    int totalMessages     = ViewBag.TotalMessages     ?? 0;
    int totalAssignments  = ViewBag.TotalAssignments  ?? 0;
    int totalExams        = ViewBag.TotalExams        ?? 0;
    int pendingApps       = ViewBag.PendingApplications ?? 0;
    int activeEnrollments = ViewBag.ActiveEnrollments   ?? 0;

    string courseLabels   = ViewBag.CourseEnrollmentLabels   ?? "[]";
    string courseData     = ViewBag.CourseEnrollmentData     ?? "[]";
    string roleLabels     = ViewBag.RoleLabels               ?? "[]";
    string roleData       = ViewBag.RoleData                 ?? "[]";
    string monthlyLabels  = ViewBag.MonthlyEnrollmentLabels  ?? "[]";
    string monthlyData    = ViewBag.MonthlyEnrollmentData    ?? "[]";

    var recentUsers = ViewBag.RecentUsers as System.Collections.IEnumerable ?? new List<object>();
}

<div class="space-y-6">

    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-gauge-high text-blue-700"></i> Admin Dashboard
            </h1>
            <p class="text-xs text-slate-400 mt-0.5">Overview of courses, enrollment statistics, and system usage</p>
        </div>
        <span class="text-xs text-slate-400"><i class="fa-regular fa-clock mr-1"></i>@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
    </div>

    <!-- Primary Stats Row -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-5 shadow-sm border border-blue-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Total Users</p>
                <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center">
                    <i class="fa-solid fa-users text-blue-700 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-blue-700">@totalUsers</p>
            <a asp-controller="Users" asp-action="Index" class="text-xs text-blue-600 hover:underline mt-1 inline-block">Manage users &rarr;</a>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-emerald-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Courses</p>
                <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center">
                    <i class="fa-solid fa-book-open text-emerald-600 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-emerald-600">@totalCourses</p>
            <a asp-controller="Courses" asp-action="Index" class="text-xs text-emerald-600 hover:underline mt-1 inline-block">View courses &rarr;</a>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-amber-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Students</p>
                <div class="w-9 h-9 rounded-lg bg-amber-50 flex items-center justify-center">
                    <i class="fa-solid fa-user-graduate text-amber-600 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-amber-600">@totalStudents</p>
            <a asp-controller="Users" asp-action="Index" class="text-xs text-amber-600 hover:underline mt-1 inline-block">View students &rarr;</a>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-purple-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Enrollments</p>
                <div class="w-9 h-9 rounded-lg bg-purple-50 flex items-center justify-center">
                    <i class="fa-solid fa-user-plus text-purple-600 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-purple-600">@totalEnrollments</p>
            <a asp-controller="Enrollments" asp-action="Index" class="text-xs text-purple-600 hover:underline mt-1 inline-block">Manage &rarr;</a>
        </div>
    </div>

    <!-- Secondary Stats Row -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-100 flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-chalkboard-user text-indigo-600 text-sm"></i>
            </div>
            <div>
                <p class="text-xs text-slate-400 uppercase tracking-wide">Lecturers</p>
                <p class="text-2xl font-bold text-indigo-600">@totalLecturers</p>
            </div>
        </div>
        <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-100 flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-rose-50 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-building-columns text-rose-600 text-sm"></i>
            </div>
            <div>
                <p class="text-xs text-slate-400 uppercase tracking-wide">Departments</p>
                <p class="text-2xl font-bold text-rose-600">@totalDepartments</p>
            </div>
        </div>
        <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-100 flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-clipboard-list text-teal-600 text-sm"></i>
            </div>
            <div>
                <p class="text-xs text-slate-400 uppercase tracking-wide">Assignments</p>
                <p class="text-2xl font-bold text-teal-600">@totalAssignments</p>
            </div>
        </div>
        <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-100 flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-file-circle-check text-orange-600 text-sm"></i>
            </div>
            <div>
                <p class="text-xs text-slate-400 uppercase tracking-wide">Exams</p>
                <p class="text-2xl font-bold text-orange-600">@totalExams</p>
            </div>
        </div>
    </div>

    <!-- Charts Row 1: Monthly Enrollments + User Role Breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Monthly Enrollment Trend (line chart) -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-slate-100 p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                    <i class="fa-solid fa-chart-line text-blue-600"></i> Enrollment Trend
                    <span class="text-xs font-normal text-slate-400">(last 6 months)</span>
                </h2>
                <span class="inline-flex items-center gap-1 text-xs bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full">
                    <i class="fa-solid fa-circle-dot text-xs"></i> @activeEnrollments active
                </span>
            </div>
            <div class="h-52">
                <canvas id="monthlyEnrollmentChart"></canvas>
            </div>
        </div>

        <!-- User Role Breakdown (doughnut chart) -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                    <i class="fa-solid fa-chart-pie text-purple-600"></i> Users by Role
                </h2>
            </div>
            <div class="h-44 flex items-center justify-center">
                <canvas id="roleBreakdownChart"></canvas>
            </div>
            <div id="roleBreakdownLegend" class="flex flex-wrap gap-2 mt-3 justify-center text-xs"></div>
        </div>

    </div>

    <!-- Charts Row 2: Course Enrollment Bar Chart + System Usage -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Course Enrollment Bar Chart -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-slate-100 p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                    <i class="fa-solid fa-chart-bar text-emerald-600"></i> Course Popularity
                    <span class="text-xs font-normal text-slate-400">(top courses by enrollments)</span>
                </h2>
                <a asp-controller="Reports" asp-action="CoursePopularity" class="text-xs text-blue-700 hover:underline">Full report &rarr;</a>
            </div>
            <div class="h-52">
                <canvas id="courseEnrollmentChart"></canvas>
            </div>
        </div>

        <!-- System Usage Summary -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5 flex flex-col gap-3">
            <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                <i class="fa-solid fa-server text-slate-500"></i> System Usage
            </h2>
            <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between py-2 border-b border-slate-50">
                    <span class="flex items-center gap-2 text-xs text-slate-600"><i class="fa-solid fa-envelope w-4 text-center text-blue-400"></i> Messages</span>
                    <span class="text-xs font-semibold text-slate-700">@totalMessages</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-slate-50">
                    <span class="flex items-center gap-2 text-xs text-slate-600"><i class="fa-solid fa-clipboard-list w-4 text-center text-teal-500"></i> Assignments</span>
                    <span class="text-xs font-semibold text-slate-700">@totalAssignments</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-slate-50">
                    <span class="flex items-center gap-2 text-xs text-slate-600"><i class="fa-solid fa-file-circle-check w-4 text-center text-orange-500"></i> Exams</span>
                    <span class="text-xs font-semibold text-slate-700">@totalExams</span>
                </div>
                <div class="flex items-center justify-between py-2 border-b border-slate-50">
                    <span class="flex items-center gap-2 text-xs text-slate-600"><i class="fa-solid fa-user-clock w-4 text-center text-amber-500"></i> Pending Applications</span>
                    @if (pendingApps > 0)
                    {
                        <span class="inline-flex items-center gap-1 text-xs bg-amber-50 text-amber-700 font-semibold px-2 py-0.5 rounded-full">@pendingApps pending</span>
                    }
                    else
                    {
                        <span class="text-xs font-semibold text-slate-700">@pendingApps</span>
                    }
                </div>
                <div class="flex items-center justify-between py-2">
                    <span class="flex items-center gap-2 text-xs text-slate-600"><i class="fa-solid fa-shield-halved w-4 text-center text-rose-500"></i> Admins</span>
                    <span class="text-xs font-semibold text-slate-700">@totalAdmins</span>
                </div>
            </div>
            <a asp-controller="EnrollmentApplications" asp-action="Index"
               class="mt-auto inline-flex items-center gap-2 justify-center bg-amber-500 hover:bg-amber-600 text-white text-xs px-3 py-2 rounded-lg transition-all">
                <i class="fa-solid fa-user-clock"></i> Review Applications
            </a>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="page-card">
        <h2 class="text-sm text-slate-700 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-bolt text-blue-700"></i> Quick Actions
        </h2>
        <div class="flex flex-wrap gap-3">
            <a asp-controller="Users" asp-action="Create"
               class="inline-flex items-center gap-2 bg-blue-700 hover:bg-blue-800 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-user-plus"></i> New User
            </a>
            <a asp-controller="Courses" asp-action="Create"
               class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-book-medical"></i> New Course
            </a>
            <a asp-controller="Departments" asp-action="Create"
               class="inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-building-columns"></i> New Department
            </a>
            <a asp-controller="Enrollments" asp-action="Create"
               class="inline-flex items-center gap-2 bg-purple-600 hover:bg-purple-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-id-card-clip"></i> Enroll Student
            </a>
            <a asp-controller="Batches" asp-action="Create"
               class="inline-flex items-center gap-2 bg-slate-600 hover:bg-slate-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-people-group"></i> New Batch
            </a>
        </div>
    </div>

    <!-- Recent Users -->
    <div class="page-card">
        <div class="flex items-center justify-between mb-5">
            <h2 class="text-sm text-slate-700 flex items-center gap-2">
                <i class="fa-solid fa-clock-rotate-left text-blue-700"></i> Recent Users
            </h2>
            <a asp-controller="Users" asp-action="Index" class="text-xs text-blue-700 hover:underline">View all &rarr;</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="table-header">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-user mr-1"></i>Name</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-envelope mr-1"></i>Email</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-shield-halved mr-1"></i>Role</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-circle-dot mr-1"></i>Status</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-calendar mr-1"></i>Joined</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (UniManage.Models.UserModel user in recentUsers)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 text-slate-800">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-blue-700 flex items-center justify-center text-white text-xs flex-shrink-0">
                                        @user.FirstName[0]
                                    </div>
                                    @user.FirstName @user.LastName
                                </div>
                            </td>
                            <td class="px-4 py-3 text-slate-500">@user.Email</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center gap-1 text-xs bg-blue-50 text-blue-700 px-2.5 py-0.5 rounded-full ">
                                    <i class="fa-solid fa-circle-dot text-xs"></i>@user.Role?.Name
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                @if (user.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 text-xs bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-full "><i class="fa-solid fa-circle-check text-xs"></i>Active</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-xs bg-red-50 text-red-700 px-2.5 py-0.5 rounded-full "><i class="fa-solid fa-circle-xmark text-xs"></i>Inactive</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-slate-400">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    const palette = {
        blue:   { bg: 'rgba(37,99,235,0.15)',   border: '#2563eb' },
        green:  { bg: 'rgba(16,185,129,0.15)',  border: '#10b981' },
        amber:  { bg: 'rgba(245,158,11,0.15)',  border: '#f59e0b' },
        purple: { bg: 'rgba(139,92,246,0.15)',  border: '#8b5cf6' },
        rose:   { bg: 'rgba(244,63,94,0.15)',   border: '#f43f5e' },
        teal:   { bg: 'rgba(20,184,166,0.15)',  border: '#14b8a6' },
    };
    const colors = [palette.blue, palette.green, palette.amber, palette.purple, palette.rose, palette.teal];

    // ── Monthly Enrollment Trend ──────────────────────────────────────────────
    const monthlyLabels = @Html.Raw(monthlyLabels);
    const monthlyData   = @Html.Raw(monthlyData);

    new Chart(document.getElementById('monthlyEnrollmentChart'), {
        type: 'line',
        data: {
            labels: monthlyLabels,
            datasets: [{
                label: 'Enrollments',
                data: monthlyData,
                fill: true,
                backgroundColor: palette.blue.bg,
                borderColor: palette.blue.border,
                borderWidth: 2,
                pointBackgroundColor: palette.blue.border,
                pointRadius: 4,
                tension: 0.4
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
            scales: {
                y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 10 }, color: '#94a3b8', stepSize: 1 } },
                x: { grid: { display: false }, ticks: { font: { size: 10 }, color: '#94a3b8' } }
            }
        }
    });

    // ── User Role Breakdown ───────────────────────────────────────────────────
    const roleLabels = @Html.Raw(roleLabels);
    const roleData   = @Html.Raw(roleData);

    new Chart(document.getElementById('roleBreakdownChart'), {
        type: 'doughnut',
        data: {
            labels: roleLabels,
            datasets: [{
                data: roleData,
                backgroundColor: colors.map(c => c.border),
                borderWidth: 2,
                borderColor: '#fff',
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            cutout: '65%',
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${ctx.parsed}` } }
            }
        }
    });

    // Build custom legend
    const legend = document.getElementById('roleBreakdownLegend');
    roleLabels.forEach((lbl, i) => {
        const dot = `<span style="background:${colors[i % colors.length].border}" class="inline-block w-2.5 h-2.5 rounded-full mr-1"></span>`;
        legend.innerHTML += `<span class="flex items-center gap-1 text-slate-500">${dot}${lbl}: <strong>${roleData[i]}</strong></span>`;
    });

    // ── Course Enrollment Bar Chart ───────────────────────────────────────────
    const courseLabels = @Html.Raw(courseLabels);
    const courseData   = @Html.Raw(courseData);

    new Chart(document.getElementById('courseEnrollmentChart'), {
        type: 'bar',
        data: {
            labels: courseLabels,
            datasets: [{
                label: 'Enrollments',
                data: courseData,
                backgroundColor: colors.map(c => c.bg),
                borderColor: colors.map(c => c.border),
                borderWidth: 2,
                borderRadius: 6
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
            scales: {
                y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 10 }, color: '#94a3b8', stepSize: 1 } },
                x: { grid: { display: false }, ticks: { font: { size: 10 }, color: '#94a3b8', maxRotation: 25 } }
            }
        }
    });
</script>
}