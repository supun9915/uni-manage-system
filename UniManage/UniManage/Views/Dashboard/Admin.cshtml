@{
    ViewData["Title"] = "Admin Dashboard";
    int totalUsers = ViewBag.TotalUsers ?? 0;
    int totalCourses = ViewBag.TotalCourses ?? 0;
    int totalStudents = ViewBag.TotalStudents ?? 0;
    int totalEnrollments = ViewBag.TotalEnrollments ?? 0;
    var recentUsers = ViewBag.RecentUsers as System.Collections.IEnumerable ?? new List<object>();
}

<div class="space-y-6">
    <!-- Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
            <p class="text-sm text-gray-500">Total Users</p>
            <p class="text-3xl font-bold text-indigo-600 mt-1">@totalUsers</p>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
            <p class="text-sm text-gray-500">Courses</p>
            <p class="text-3xl font-bold text-green-500 mt-1">@totalCourses</p>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
            <p class="text-sm text-gray-500">Students</p>
            <p class="text-3xl font-bold text-orange-500 mt-1">@totalStudents</p>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
            <p class="text-sm text-gray-500">Enrollments</p>
            <p class="text-3xl font-bold text-purple-500 mt-1">@totalEnrollments</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
        <h2 class="text-base font-semibold text-gray-800 mb-4">Quick Actions</h2>
        <div class="flex flex-wrap gap-3">
            <a asp-controller="Users" asp-action="Create"
               class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">
                + New User
            </a>
            <a asp-controller="Courses" asp-action="Create"
               class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">
                + New Course
            </a>
            <a asp-controller="Departments" asp-action="Create"
               class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">
                + New Department
            </a>
            <a asp-controller="Enrollments" asp-action="Create"
               class="inline-flex items-center gap-2 bg-purple-600 hover:bg-purple-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">
                + Enroll Student
            </a>
            <a asp-controller="Batches" asp-action="Create"
               class="inline-flex items-center gap-2 bg-gray-600 hover:bg-gray-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">
                + New Batch
            </a>
        </div>
    </div>

    <!-- Recent Users -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-semibold text-gray-800">Recent Users</h2>
            <a asp-controller="Users" asp-action="Index" class="text-xs text-indigo-600 hover:underline">View all</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-xs text-gray-500 border-b">
                        <th class="pb-2 font-medium">Name</th>
                        <th class="pb-2 font-medium">Email</th>
                        <th class="pb-2 font-medium">Role</th>
                        <th class="pb-2 font-medium">Status</th>
                        <th class="pb-2 font-medium">Joined</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @foreach (UniManage.Models.UserModel user in recentUsers)
                    {
                        <tr>
                            <td class="py-2.5 font-medium">@user.FirstName @user.LastName</td>
                            <td class="py-2.5 text-gray-500">@user.Email</td>
                            <td class="py-2.5">
                                <span class="text-xs bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-full">@user.Role?.Name</span>
                            </td>
                            <td class="py-2.5">
                                @if (user.IsActive)
                                {
                                    <span class="text-xs bg-green-50 text-green-700 px-2 py-0.5 rounded-full">Active</span>
                                }
                                else
                                {
                                    <span class="text-xs bg-red-50 text-red-700 px-2 py-0.5 rounded-full">Inactive</span>
                                }
                            </td>
                            <td class="py-2.5 text-gray-400">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
