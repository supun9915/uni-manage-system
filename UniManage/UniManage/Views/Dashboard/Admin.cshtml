@{
    ViewData["Title"] = "Admin Dashboard";
    int totalUsers = ViewBag.TotalUsers ?? 0;
    int totalCourses = ViewBag.TotalCourses ?? 0;
    int totalStudents = ViewBag.TotalStudents ?? 0;
    int totalEnrollments = ViewBag.TotalEnrollments ?? 0;
    var recentUsers = ViewBag.RecentUsers as System.Collections.IEnumerable ?? new List<object>();
}

<div class="space-y-6">
    <!-- Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-5 shadow-sm border border-blue-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Total Users</p>
                <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center">
                    <i class="fa-solid fa-users text-blue-700 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl text-blue-700">@totalUsers</p>
            <a asp-controller="Users" asp-action="Index" class="text-xs text-blue-600 hover:underline mt-1 inline-block">Manage users &rarr;</a>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-emerald-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Courses</p>
                <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center">
                    <i class="fa-solid fa-book-open text-emerald-600 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl text-emerald-600">@totalCourses</p>
            <a asp-controller="Courses" asp-action="Index" class="text-xs text-emerald-600 hover:underline mt-1 inline-block">View courses &rarr;</a>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-amber-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Students</p>
                <div class="w-9 h-9 rounded-lg bg-amber-50 flex items-center justify-center">
                    <i class="fa-solid fa-user-graduate text-amber-600 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl text-amber-600">@totalStudents</p>
            <a asp-controller="Users" asp-action="Index" class="text-xs text-amber-600 hover:underline mt-1 inline-block">View students &rarr;</a>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-purple-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Enrollments</p>
                <div class="w-9 h-9 rounded-lg bg-purple-50 flex items-center justify-center">
                    <i class="fa-solid fa-user-plus text-purple-600 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl text-purple-600">@totalEnrollments</p>
            <a asp-controller="Enrollments" asp-action="Index" class="text-xs text-purple-600 hover:underline mt-1 inline-block">Manage &rarr;</a>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="page-card">
        <h2 class="text-sm text-slate-700 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-bolt text-blue-700"></i> Quick Actions
        </h2>
        <div class="flex flex-wrap gap-3">
            <a asp-controller="Users" asp-action="Create"
               class="inline-flex items-center gap-2 bg-blue-700 hover:bg-blue-800 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-user-plus"></i> New User
            </a>
            <a asp-controller="Courses" asp-action="Create"
               class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-book-medical"></i> New Course
            </a>
            <a asp-controller="Departments" asp-action="Create"
               class="inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-building-columns"></i> New Department
            </a>
            <a asp-controller="Enrollments" asp-action="Create"
               class="inline-flex items-center gap-2 bg-purple-600 hover:bg-purple-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-id-card-clip"></i> Enroll Student
            </a>
            <a asp-controller="Batches" asp-action="Create"
               class="inline-flex items-center gap-2 bg-slate-600 hover:bg-slate-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-people-group"></i> New Batch
            </a>
        </div>
    </div>

    <!-- Recent Users -->
    <div class="page-card">
        <div class="flex items-center justify-between mb-5">
            <h2 class="text-sm text-slate-700 flex items-center gap-2">
                <i class="fa-solid fa-clock-rotate-left text-blue-700"></i> Recent Users
            </h2>
            <a asp-controller="Users" asp-action="Index" class="text-xs text-blue-700 hover:underline">View all &rarr;</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="table-header">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-user mr-1"></i>Name</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-envelope mr-1"></i>Email</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-shield-halved mr-1"></i>Role</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-circle-dot mr-1"></i>Status</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-calendar mr-1"></i>Joined</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (UniManage.Models.UserModel user in recentUsers)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 text-slate-800">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-blue-700 flex items-center justify-center text-white text-xs flex-shrink-0">
                                        @user.FirstName[0]
                                    </div>
                                    @user.FirstName @user.LastName
                                </div>
                            </td>
                            <td class="px-4 py-3 text-slate-500">@user.Email</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center gap-1 text-xs bg-blue-50 text-blue-700 px-2.5 py-0.5 rounded-full ">
                                    <i class="fa-solid fa-circle-dot text-xs"></i>@user.Role?.Name
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                @if (user.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 text-xs bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-full "><i class="fa-solid fa-circle-check text-xs"></i>Active</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-xs bg-red-50 text-red-700 px-2.5 py-0.5 rounded-full "><i class="fa-solid fa-circle-xmark text-xs"></i>Inactive</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-slate-400">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
