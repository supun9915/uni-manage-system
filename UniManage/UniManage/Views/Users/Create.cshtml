@model UniManage.Models.UserModel
@{
    ViewData["Title"] = "Create User";
}

<div class="max-w-lg mx-auto">
    <div class="page-card">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
                <i class="fa-solid fa-user-plus text-blue-700"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Create New User</h2>
                <p class="text-xs text-slate-400">Fill in the user details below</p>
            </div>
        </div>
        <form asp-action="Create" method="post" data-val="true">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="FirstName" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-user mr-1"></i>First Name</label>
                    <input asp-for="FirstName" class="form-input" placeholder="First name" required />
                    <span asp-validation-for="FirstName" class="field-error"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-user mr-1"></i>Last Name</label>
                    <input asp-for="LastName" class="form-input" placeholder="Last name" required />
                    <span asp-validation-for="LastName" class="field-error"></span>
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="Email" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-envelope mr-1"></i>Email Address</label>
                <input asp-for="Email" type="email" class="form-input" placeholder="email@university.edu" required />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="mb-4">
                <label for="password" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-lock mr-1"></i>Password</label>
                <div class="relative">
                    <input type="password" id="createPassword" name="password" required class="form-input" placeholder="Enter password" autocomplete="new-password" />
                    <button type="button" onclick="togglePwd('createPassword','createEye')" tabindex="-1"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                        <i id="createEye" class="fa-solid fa-eye text-sm"></i>
                    </button>
                </div>
                <span id="createPwdErr" class="text-red-600 text-xs mt-1 hidden flex items-center gap-1"><i class="fa-solid fa-triangle-exclamation"></i><span></span></span>
                <!-- Live rules -->
                <div class="mt-2 space-y-1 pl-0.5" id="createRules">
                    <p class="pwd-rule" id="cr-len"><i class="fa-solid fa-circle text-xs"></i> At least 6 characters</p>
                    <p class="pwd-rule" id="cr-low"><i class="fa-solid fa-circle text-xs"></i> One lowercase letter</p>
                    <p class="pwd-rule" id="cr-up"><i class="fa-solid fa-circle text-xs"></i> One uppercase letter</p>
                    <p class="pwd-rule" id="cr-num"><i class="fa-solid fa-circle text-xs"></i> One number</p>
                    <p class="pwd-rule" id="cr-spc"><i class="fa-solid fa-circle text-xs"></i> One special character (e.g. @@ # ! $)</p>
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="RoleId" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-shield-halved mr-1"></i>Role</label>
                <select asp-for="RoleId" asp-items="ViewBag.Roles" class="form-input" required>
                    <option value="">-- Select Role --</option>
                </select>
                <span asp-validation-for="RoleId" class="field-error"></span>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="Phone" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-phone mr-1"></i>Phone</label>
                    <input asp-for="Phone" class="form-input" placeholder="+1 234 567 8900" />
                </div>
                <div>
                    <label asp-for="NIC" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-id-card mr-1"></i>NIC</label>
                    <input asp-for="NIC" class="form-input" placeholder="NIC number" />
                    <span asp-validation-for="NIC" class="field-error"></span>
                </div>
            </div>
            <div class="mb-6 flex items-center gap-2.5 p-3 bg-slate-50 rounded-lg">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 rounded accent-blue-700" />
                <label asp-for="IsActive" class="text-sm text-slate-600 font-medium cursor-pointer"><i class="fa-solid fa-circle-check mr-1 text-emerald-500"></i>Active account</label>
            </div>
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button type="submit" id="createSubmitBtn" class="text-sm bg-blue-900 hover:bg-blue-950 px-8 py-1 text-white rounded-lg border border-blue-900"><i class="fa-solid fa-floppy-disk"></i> Create User</button>
                <a asp-action="Index" class="btn-secondary py-1"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>

<style>
    .pwd-rule { display:flex; align-items:center; gap:0.4rem; font-size:0.72rem; color:#94a3b8; }
    .pwd-rule.pass { color:#16a34a; }
</style>

@section Scripts {
<script>
    function togglePwd(id, eyeId) {
        var el = document.getElementById(id);
        var ic = document.getElementById(eyeId);
        el.type = el.type === 'password' ? 'text' : 'password';
        ic.className = el.type === 'text' ? 'fa-solid fa-eye-slash text-sm' : 'fa-solid fa-eye text-sm';
    }
    function pwdRule(id, pass) {
        var el = document.getElementById(id);
        el.className = 'pwd-rule' + (pass ? ' pass' : '');
        el.querySelector('i').className = pass ? 'fa-solid fa-circle-check text-xs' : 'fa-solid fa-circle text-xs';
    }
    var pwdRegex = { len:/^.{6,}$/, low:/[a-z]/, up:/[A-Z]/, num:/[0-9]/, spc:/[^a-zA-Z0-9]/ };
    document.getElementById('createPassword').addEventListener('input', function() {
        var v = this.value;
        pwdRule('cr-len', pwdRegex.len.test(v));
        pwdRule('cr-low', pwdRegex.low.test(v));
        pwdRule('cr-up',  pwdRegex.up.test(v));
        pwdRule('cr-num', pwdRegex.num.test(v));
        pwdRule('cr-spc', pwdRegex.spc.test(v));
    });
    document.querySelector('form').addEventListener('submit', function(e) {
        var v = document.getElementById('createPassword').value;
        var errEl = document.getElementById('createPwdErr');
        var msg = '';
        if (!pwdRegex.len.test(v))      msg = 'At least 6 characters required.';
        else if (!pwdRegex.low.test(v)) msg = 'At least one lowercase letter required.';
        else if (!pwdRegex.up.test(v))  msg = 'At least one uppercase letter required.';
        else if (!pwdRegex.num.test(v)) msg = 'At least one number required.';
        else if (!pwdRegex.spc.test(v)) msg = 'At least one special character required.';
        if (msg) {
            e.preventDefault();
            errEl.querySelector('span').textContent = msg;
            errEl.classList.remove('hidden');
            errEl.style.display = 'flex';
        } else {
            errEl.classList.add('hidden');
        }
    });
</script>
}
