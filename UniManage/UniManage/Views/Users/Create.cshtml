@model UniManage.Models.UserModel
@{
    ViewData["Title"] = "Create User";
}

<div class="max-w-lg">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-base font-semibold text-gray-800 mb-5">Create New User</h2>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="FirstName" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    <span asp-validation-for="FirstName" class="text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="LastName" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    <span asp-validation-for="LastName" class="text-xs text-red-600"></span>
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Email" type="email" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="Email" class="text-xs text-red-600"></span>
            </div>
            <div class="mb-4">
                <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                <input type="password" name="password" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div class="mb-4">
                <label asp-for="RoleId" class="block text-sm font-medium text-gray-700 mb-1">Role</label>
                <select asp-for="RoleId" asp-items="ViewBag.Roles" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="">-- Select Role --</option>
                </select>
                <span asp-validation-for="RoleId" class="text-xs text-red-600"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Phone" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Phone" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div class="mb-6 flex items-center gap-2">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-indigo-600 rounded" />
                <label asp-for="IsActive" class="text-sm text-gray-700">Active</label>
            </div>
            <div class="flex gap-3">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors">Create</button>
                <a asp-action="Index" class="text-sm font-medium text-gray-500 hover:text-gray-700 px-5 py-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
