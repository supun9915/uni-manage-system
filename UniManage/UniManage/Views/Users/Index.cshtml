@model IEnumerable<UniManage.Models.UserModel>
@{
    ViewData["Title"] = "Users";
}

<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <div class="flex items-center justify-between mb-5">
        <h2 class="text-base font-semibold text-gray-800">All Users</h2>
        <a asp-action="Create" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">+ New User</a>
    </div>
    <form method="get" class="mb-4 flex gap-2">
        <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by name or email..."
               class="flex-1 max-w-sm px-4 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        <button type="submit" class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm px-4 py-2 rounded-lg">Search</button>
    </form>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-xs text-gray-500 border-b">
                    <th class="pb-2 font-medium">Name</th>
                    <th class="pb-2 font-medium">Email</th>
                    <th class="pb-2 font-medium">Role</th>
                    <th class="pb-2 font-medium">Phone</th>
                    <th class="pb-2 font-medium">Status</th>
                    <th class="pb-2 font-medium">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="py-2.5 font-medium">@u.FirstName @u.LastName</td>
                        <td class="py-2.5 text-gray-500">@u.Email</td>
                        <td class="py-2.5">
                            <span class="text-xs bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-full">@u.Role?.Name</span>
                        </td>
                        <td class="py-2.5 text-gray-500">@u.Phone</td>
                        <td class="py-2.5">
                            @if (u.IsActive)
                            {
                                <span class="text-xs bg-green-50 text-green-700 px-2 py-0.5 rounded-full">Active</span>
                            }
                            else
                            {
                                <span class="text-xs bg-red-50 text-red-700 px-2 py-0.5 rounded-full">Inactive</span>
                            }
                        </td>
                        <td class="py-2.5 flex gap-2">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="text-xs bg-yellow-50 text-yellow-700 px-3 py-1 rounded-full hover:bg-yellow-100">Edit</a>
                            <a asp-action="Delete" asp-route-id="@u.Id" class="text-xs bg-red-50 text-red-700 px-3 py-1 rounded-full hover:bg-red-100">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
