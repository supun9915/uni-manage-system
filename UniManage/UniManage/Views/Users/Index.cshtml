@model IEnumerable<UniManage.Models.UserModel>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Users";
}

<div class="page-card">
    <div class="flex items-center justify-between mb-5">
        <h2 class="text-sm text-slate-700 flex items-center gap-2">
            <i class="fa-solid fa-users text-blue-700"></i> All Users
        </h2>
        <a asp-action="Create" class="text-sm bg-blue-900 px-8 py-1 text-white rounded-lg border border-blue-700"><i class="fa-solid fa-user-plus text-sm"></i> New User</a>
    </div>
    <form method="get" class="mb-5 flex flex-wrap gap-2 items-center">
        <div class="relative flex-1 min-w-[200px] max-w-sm">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by name, email, NIC or UID..."
                   class="form-input pl-9" />
        </div>
        @Html.DropDownList("roleId", (SelectList)ViewBag.Roles, "All Roles",
            new { @class = "text-sm border border-slate-200 rounded-lg px-3 py-[0.625rem] focus:outline-none focus:ring-2 focus:ring-blue-300 text-slate-600" })
        <button type="submit" class="btn-secondary"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.RoleId != null)
        {
            <a asp-action="Index" class="text-xs text-slate-400 hover:text-red-500 px-2">
                <i class="fa-solid fa-xmark mr-1"></i>Clear
            </a>
        }
    </form>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="table-header">
                <tr>
                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-user mr-1"></i>Name</th>
                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-id-badge mr-1"></i>UID</th>
                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-id-card mr-1"></i>NIC</th>
                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-envelope mr-1"></i>Email</th>
                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-shield-halved mr-1"></i>Role</th>
                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-phone mr-1"></i>Phone</th>
                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-circle-dot mr-1"></i>Status</th>
                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var u in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-4 py-3 font-medium text-slate-800">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-full bg-blue-900 flex items-center justify-center text-white text-xs flex-shrink-0">@u.FirstName[0]</div>
                                @u.FirstName @u.LastName
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            @if (!string.IsNullOrEmpty(u.UID))
                            {
                                <span class="inline-flex items-center text-xs bg-slate-100 text-slate-700 px-2.5 py-0.5 rounded-full font-mono font-medium">@u.UID</span>
                            }
                            else
                            {
                                <span class="text-slate-300 text-xs">&mdash;</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-slate-500 font-mono text-xs">@(u.NIC ?? "—")</td>
                        <td class="px-4 py-3 text-slate-500">@u.Email</td>
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center gap-1 text-xs bg-blue-50 text-blue-700 px-2.5 py-0.5 rounded-full font-medium"><i class="fa-solid fa-circle-dot text-xs"></i>@u.Role?.Name</span>
                        </td>
                        <td class="px-4 py-3 text-slate-500">@(u.Phone ?? "—")</td>
                        <td class="px-4 py-3">
                            @if (u.IsActive)
                            {
                                <span class="inline-flex items-center gap-1 text-xs bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-full font-medium"><i class="fa-solid fa-circle-check text-xs"></i>Active</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 text-xs bg-red-50 text-red-700 px-2.5 py-0.5 rounded-full font-medium"><i class="fa-solid fa-circle-xmark text-xs"></i>Inactive</span>
                            }
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex gap-2">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="inline-flex items-center gap-1 text-xs bg-amber-50 text-amber-700 px-3 py-1 rounded-full hover:bg-amber-100 transition-colors"><i class="fa-solid fa-pen text-xs"></i>Edit</a>
                                <a asp-action="Delete" asp-route-id="@u.Id" class="inline-flex items-center gap-1 text-xs bg-red-50 text-red-700 px-3 py-1 rounded-full hover:bg-red-100 transition-colors"><i class="fa-solid fa-trash text-xs"></i>Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="flex flex-col items-center py-12 text-slate-400">
                <i class="fa-solid fa-users text-4xl mb-3 opacity-30"></i>
                <p class="text-sm">No users found.</p>
            </div>
        }
    </div>
</div>
