@model UniManage.Models.UserModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="max-w-lg">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-base font-semibold text-gray-800 mb-2">Delete User</h2>
        <p class="text-sm text-gray-500 mb-4">Are you sure you want to delete this user?</p>
        <div class="bg-gray-50 rounded-lg p-4 mb-5 text-sm space-y-1">
            <p><span class="text-gray-500">Name:</span> <strong>@Model.FirstName @Model.LastName</strong></p>
            <p><span class="text-gray-500">Email:</span> @Model.Email</p>
            <p><span class="text-gray-500">Role:</span> @Model.Role?.Name</p>
        </div>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="flex gap-3">
                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors">Delete</button>
                <a asp-action="Index" class="text-sm font-medium text-gray-500 hover:text-gray-700 px-5 py-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
