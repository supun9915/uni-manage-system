@{
    ViewData["Title"] = "Compose Message";
    var replyTo = ViewBag.ReplyTo as UniManage.Models.MessageModel;
    var defaultSubject = ViewBag.DefaultSubject as string ?? "";
    var defaultReceiverId = ViewBag.DefaultReceiverId as int?;
}

<div class="space-y-4">
    <div class="page-card">
        <div class="flex items-center justify-between mb-5">
            <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                <i class="fa-solid fa-pen text-blue-700"></i>
                @(replyTo != null ? "Reply to Message" : "New Message")
            </h2>
            <a asp-action="Inbox" class="inline-flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-700 transition-colors">
                <i class="fa-solid fa-arrow-left text-xs"></i> Back
            </a>
        </div>

        @if (replyTo != null)
        {
            <div class="mb-5 p-3 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-500">
                <p class="font-semibold text-slate-600 mb-1"><i class="fa-solid fa-reply mr-1"></i>Replying to: @replyTo.Subject</p>
                <p class="line-clamp-2 italic">@replyTo.Body</p>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="mb-4 flex items-start gap-2.5 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg">
                <i class="fa-solid fa-circle-xmark mt-0.5 flex-shrink-0"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        <form asp-action="Compose" method="post" id="composeForm" novalidate>
            @Html.AntiForgeryToken()
            @if (replyTo != null)
            {
                <input type="hidden" name="replyToId" value="@replyTo.Id" />
            }

            <!-- To -->
            <div class="mb-4">
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
                    <i class="fa-solid fa-user mr-1"></i> To
                </label>
                <select name="receiverId" id="receiverId" required
                        class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-300 text-slate-700 bg-white">
                    <option value="">— Select recipient —</option>
                    @foreach (var item in (ViewBag.Recipients as Microsoft.AspNetCore.Mvc.Rendering.SelectList ?? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(new List<object>())))
                    {
                        if (defaultReceiverId.HasValue && item.Value == defaultReceiverId.Value.ToString())
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
                <p id="toErr" class="text-red-600 text-xs mt-1 hidden"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Please select a recipient.</p>
            </div>

            <!-- Subject -->
            <div class="mb-4">
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
                    <i class="fa-solid fa-tag mr-1"></i> Subject
                </label>
                <input type="text" name="subject" id="subject" required maxlength="200"
                       value="@defaultSubject"
                       placeholder="Enter subject..."
                       class="w-full text-sm border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-300 text-slate-700" />
                <p id="subjectErr" class="text-red-600 text-xs mt-1 hidden"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Subject is required.</p>
            </div>

            <!-- Body -->
            <div class="mb-5">
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
                    <i class="fa-solid fa-message mr-1"></i> Message
                </label>
                <textarea name="body" id="body" rows="8" required
                          placeholder="Write your message here..."
                          class="w-full text-sm border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-300 resize-y text-slate-700 leading-relaxed"></textarea>
                <p id="bodyErr" class="text-red-600 text-xs mt-1 hidden"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Message body is required.</p>
            </div>

            <div class="flex items-center justify-between">
                <a asp-action="Inbox" class="text-sm text-slate-500 hover:text-slate-700 transition-colors">Cancel</a>
                <button type="submit" id="sendBtn"
                        class="inline-flex items-center gap-2 text-sm text-white bg-blue-700 hover:bg-blue-800 px-6 py-2.5 rounded-xl shadow-sm transition-colors">
                    <i class="fa-solid fa-paper-plane"></i> Send Message
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('composeForm').addEventListener('submit', function (e) {
        var ok = true;
        function check(id, errId, msg) {
            var el = document.getElementById(id);
            var err = document.getElementById(errId);
            if (!el.value.trim()) {
                el.classList.add('border-red-400');
                err.classList.remove('hidden');
                ok = false;
            } else {
                el.classList.remove('border-red-400');
                err.classList.add('hidden');
            }
        }
        check('receiverId', 'toErr', '');
        check('subject', 'subjectErr', '');
        check('body', 'bodyErr', '');
        if (!ok) { e.preventDefault(); return; }
        var btn = document.getElementById('sendBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
    });
</script>
