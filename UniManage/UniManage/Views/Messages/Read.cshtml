@{
    ViewData["Title"] = "Message";
    var root = ViewBag.Root as UniManage.Models.MessageModel;
    var currentUserId = ViewBag.CurrentUserId as int?;
}

<div class="space-y-4">
    <!-- Back + actions bar -->
    <div class="page-card">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a asp-action="Inbox" class="inline-flex items-center gap-1.5 text-xs text-slate-600 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition-colors">
                    <i class="fa-solid fa-arrow-left text-xs"></i> Back to Inbox
                </a>
                <h2 class="text-sm font-semibold text-slate-700 truncate max-w-sm">@root?.Subject</h2>
            </div>
            <div class="flex items-center gap-2">
                <a asp-action="Compose" asp-route-replyToId="@root?.Id"
                   class="inline-flex items-center gap-1.5 text-xs text-white bg-blue-700 hover:bg-blue-800 px-3 py-1.5 rounded-lg shadow-sm transition-colors">
                    <i class="fa-solid fa-reply text-xs"></i> Reply
                </a>
                <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this message?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@root?.Id" />
                    <input type="hidden" name="returnTo" value="inbox" />
                    <button type="submit"
                            class="inline-flex items-center gap-1.5 text-xs text-red-600 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-lg transition-colors">
                        <i class="fa-solid fa-trash text-xs"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Thread -->
    <div class="space-y-3">
        @foreach (var msg in Model)
        {
            var isMine = msg.SenderId == currentUserId;
            <div class="page-card @(isMine ? "border-l-4 border-blue-400" : "border-l-4 border-slate-300")">
                <div class="flex items-start justify-between gap-4">
                    <div class="flex items-start gap-3">
                        <div class="w-9 h-9 rounded-full @(isMine ? "bg-blue-700" : "bg-slate-500") flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
                            @(msg.Sender?.FirstName?.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-slate-800">
                                @msg.Sender?.FirstName @msg.Sender?.LastName
                                @if (isMine)
                                {
                                    <span class="text-xs font-normal text-blue-600 ml-1">(You)</span>
                                }
                                else
                                {
                                    <span class="text-xs font-normal text-slate-400 ml-1">(@msg.Sender?.Role?.Name)</span>
                                }
                            </p>
                            <p class="text-xs text-slate-400 mt-0.5">
                                <i class="fa-regular fa-clock mr-1"></i>@msg.SentAt.ToString("dd MMM yyyy, HH:mm")
                                &nbsp;·&nbsp;
                                <i class="fa-solid fa-user mr-1"></i>@msg.Receiver?.FirstName @msg.Receiver?.LastName
                            </p>
                        </div>
                    </div>
                    @if (!isMine)
                    {
                        <a asp-action="Compose" asp-route-replyToId="@root?.Id"
                           class="inline-flex items-center gap-1 text-xs text-blue-600 hover:underline flex-shrink-0">
                            <i class="fa-solid fa-reply text-xs"></i> Reply
                        </a>
                    }
                </div>
                <div class="mt-3 pl-12">
                    <p class="text-sm text-slate-700 leading-relaxed whitespace-pre-wrap">@msg.Body</p>
                </div>
            </div>
        }
    </div>

    <!-- Quick reply box -->
    <div class="page-card">
        <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">
            <i class="fa-solid fa-reply mr-1"></i> Quick Reply
        </h3>
        <form asp-action="Compose" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="receiverId" value="@(root?.SenderId == currentUserId ? root?.ReceiverId : root?.SenderId)" />
            <input type="hidden" name="subject" value="@(root?.Subject.StartsWith("Re: ") == true ? root?.Subject : $"Re: {root?.Subject}")" />
            <input type="hidden" name="replyToId" value="@root?.Id" />
            <textarea name="body" rows="4" required placeholder="Write your reply here..."
                      class="w-full text-sm border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-300 resize-none text-slate-700"></textarea>
            <div class="flex justify-end mt-3">
                <button type="submit"
                        class="inline-flex items-center gap-2 text-sm text-white bg-blue-700 hover:bg-blue-800 px-5 py-2 rounded-lg shadow-sm transition-colors">
                    <i class="fa-solid fa-paper-plane"></i> Send Reply
                </button>
            </div>
        </form>
    </div>
</div>
