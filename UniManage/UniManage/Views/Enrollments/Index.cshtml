@model IEnumerable<UniManage.Models.EnrollmentModel>
@{
    ViewData["Title"] = "Enrollments";
}
<div class="page-card">
    <div class="flex items-center justify-between mb-5">
        <h2 class="text-sm text-slate-700 flex items-center gap-2">
            <i class="fa-solid fa-user-graduate text-blue-700"></i> Enrollments
        </h2>
        <a asp-action="Create" class="btn-primary">
            <i class="fa-solid fa-plus"></i> Enroll Student
        </a>
    </div>

    <form method="get" class="mb-4 flex items-center gap-3">
        <label class="text-xs text-slate-500">Filter by Course:</label>
        @Html.DropDownList("courseId", (SelectList)ViewBag.Courses, "All Courses", new { @class = "text-sm border border-slate-200 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-300" })
        <button type="submit" class="btn-primary py-1.5 px-4 text-xs">Filter</button>
        @if (ViewBag.CourseId != null)
        {
            <a asp-action="Index" class="text-xs text-slate-400 hover:text-red-500">Clear</a>
        }
    </form>

    @if (!Model.Any())
    {
        <div class="flex flex-col items-center py-12 text-slate-400">
            <i class="fa-solid fa-users text-4xl mb-3 opacity-30"></i>
            <p class="text-sm">No enrollments found.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="table-header">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-user mr-1"></i>Student</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-book mr-1"></i>Course</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-layer-group mr-1"></i>Batch</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-calendar mr-1"></i>Enrolled At</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-circle-dot mr-1"></i>Status</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var e in Model)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 font-medium text-slate-800">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-blue-700 flex items-center justify-center text-white text-xs flex-shrink-0">@(e.User?.FirstName?[0])</div>
                                    @e.User?.FirstName @e.User?.LastName
                                </div>
                            </td>
                            <td class="px-4 py-3 text-slate-600">@e.Course?.Title</td>
                            <td class="px-4 py-3 text-slate-600">@e.Batch?.Name</td>
                            <td class="px-4 py-3 text-slate-400">@e.EnrolledAt.ToString("dd MMM yyyy")</td>
                            <td class="px-4 py-3">
                                @{
                                    var cls = e.Status == "active" ? "bg-emerald-50 text-emerald-700" : "bg-red-50 text-red-700";
                                }
                                <span class="inline-flex items-center gap-1 text-xs @cls px-2.5 py-0.5 rounded-full font-medium capitalize">@e.Status</span>
                            </td>
                            <td class="px-4 py-3">
                                <a asp-action="Delete" asp-route-id="@e.Id"
                                   class="text-xs bg-red-50 text-red-700 px-3 py-1 rounded-full hover:bg-red-100">
                                    <i class="fa-solid fa-trash text-xs mr-0.5"></i>Remove
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
