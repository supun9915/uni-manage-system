@model UniManage.Models.DepartmentModel
@{
    ViewData["Title"] = "Edit Department";
}
<div class="max-w-lg mx-auto">
    <div class="page-card">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center">
                <i class="fa-solid fa-building-columns text-amber-600"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Edit Department</h2>
                <p class="text-xs text-slate-400">Update department details</p>
            </div>
        </div>
        <form asp-action="Edit" method="post" data-val="true">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-4">
                <label asp-for="Name" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-building mr-1"></i>Department Name</label>
                <input asp-for="Name" class="form-input" required />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Code" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-hashtag mr-1"></i>Code</label>
                <input asp-for="Code" class="form-input" />
            </div>
            <div class="mb-6">
                <label asp-for="Description" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-align-left mr-1"></i>Description</label>
                <textarea asp-for="Description" rows="3" class="form-input"></textarea>
            </div>
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="text-sm bg-blue-900 hover:bg-blue-950 px-8 py-1 text-white rounded-lg border border-blue-900"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
                <a asp-action="Index" class="btn-secondary py-1"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>
