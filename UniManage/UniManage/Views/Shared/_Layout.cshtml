<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniManage</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style type="text/tailwindcss">
        @@layer components {
            .sidebar-link {
                @@apply flex items-center gap-3 px-4 py-[0.65rem] rounded-lg text-[0.8125rem] transition-all duration-150 text-white/80 no-underline;
            }
            .sidebar-link:hover {
                @@apply bg-white/10 text-white;
            }
            .sidebar-link.active {
                @@apply bg-white text-blue-900 font-medium shadow-[0_2px_8px_rgba(0,0,0,0.15)];
            }
            .sidebar-link.active .fa-fw {
                @@apply opacity-100 text-blue-900;
            }
            .sidebar-link .fa-fw {
                @@apply w-5 text-sm opacity-85;
            }
            .form-input {
                @@apply w-full px-4 py-[0.625rem] border-[1.5px] border-gray-300 rounded-lg text-sm transition-all duration-150 outline-none;
            }
            .form-input:focus {
                @@apply border-blue-700 shadow-[0_0_0_3px_rgba(29,78,216,0.12)];
            }
            .form-input.input-error {
                @@apply border-red-500 shadow-[0_0_0_3px_rgba(239,68,68,0.1)];
            }
            .form-input.input-valid {
                @@apply border-green-500;
            }
            .field-error {
                @@apply text-red-600 text-xs mt-1 flex items-center gap-1;
            }
            .btn-primary {
                @@apply bg-blue-700 text-white text-sm px-5 py-[0.625rem] rounded-lg transition-all duration-150 inline-flex items-center gap-2 border-0 cursor-pointer no-underline;
            }
            .btn-primary:hover {
                @@apply bg-blue-800 shadow-[0_4px_12px_rgba(29,78,216,0.35)] -translate-y-px;
            }
            .btn-danger {
                @@apply bg-red-600 text-white text-sm px-5 py-[0.625rem] rounded-lg transition-all duration-150 inline-flex items-center gap-2 border-0 cursor-pointer no-underline;
            }
            .btn-danger:hover {
                @@apply bg-red-700 shadow-[0_4px_12px_rgba(220,38,38,0.3)];
            }
            .btn-secondary {
                @@apply bg-slate-100 text-slate-600 text-sm px-5 py-[0.625rem] rounded-lg transition-all duration-150 inline-flex items-center gap-2 no-underline border-[1.5px] border-slate-200;
            }
            .btn-secondary:hover {
                @@apply bg-slate-200 text-slate-700;
            }
            .page-card {
                @@apply bg-white rounded-2xl shadow-[0_1px_3px_rgba(0,0,0,0.07),0_4px_16px_rgba(0,0,0,0.04)] p-6;
            }
            .table-header {
                background: linear-gradient(90deg, #0f172a, #1e3a8a);
            }
            .status-badge {
                @@apply inline-flex items-center gap-[0.3rem] px-[0.65rem] py-[0.2rem] rounded-full text-[0.7rem] capitalize;
            }
            .toast-success {
                @@apply bg-green-50 border border-green-200 text-green-700 px-4 py-[0.6rem] rounded-lg text-[0.8125rem] flex items-center gap-2;
            }
            .toast-error {
                @@apply bg-red-50 border border-red-200 text-red-800 px-4 py-[0.6rem] rounded-lg text-[0.8125rem] flex items-center gap-2;
            }
            .card-stat {
                @@apply bg-white rounded-[0.875rem] px-6 py-5 shadow-sm border border-slate-100;
            }
        }
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { @@apply bg-blue-900/10; }
        ::-webkit-scrollbar-thumb { @@apply bg-blue-700 rounded-[10px]; }
    </style>
</head>
<body class="font-sans bg-slate-100 min-h-screen">
@{
    var role = ViewBag.CurrentUserRole as string;
    var isLoggedIn = ViewBag.CurrentUserId != null;
    string ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

@if (isLoggedIn)
{
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <aside class="w-64 flex-shrink-0 flex flex-col" style="background:linear-gradient(180deg,#0d1b2a 0%,#0f2042 100%);">
            <!-- Logo -->
            <div class="h-16 flex items-center px-5 gap-3" style="border-bottom:1px solid rgba(255,255,255,0.08);">
                <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center">
                    <i class="fa-solid fa-graduation-cap text-white text-sm"></i>
                </div>
                <span class="text-base text-white tracking-tight">UniManage</span>
            </div>
            <!-- Nav -->
            <nav class="flex-1 overflow-y-auto py-3 px-3 space-y-0.5">
                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link @(ctrl=="Dashboard"?"active":"")">
                    <i class="fa-solid fa-house fa-fw"></i> Dashboard
                </a>
                <a asp-controller="Courses" asp-action="Index" class="sidebar-link @(ctrl=="Courses"?"active":"")">
                    <i class="fa-solid fa-book-open fa-fw"></i> Courses
                </a>
                @if (role != "student")
                {
                    <a asp-controller="Modules" asp-action="Index" class="sidebar-link @(ctrl=="Modules"?"active":"")">
                        <i class="fa-solid fa-layer-group fa-fw"></i> Modules
                    </a>
                }
                <a asp-controller="CourseMaterials" asp-action="Index" class="sidebar-link @(ctrl=="CourseMaterials"?"active":"")">
                    <i class="fa-solid fa-file-lines fa-fw"></i> Materials
                </a>
                <a asp-controller="Assignments" asp-action="Index" class="sidebar-link @(ctrl=="Assignments"?"active":"")">
                    <i class="fa-solid fa-clipboard-list fa-fw"></i> Assignments
                </a>
                @if (role == "student")
                {
                    <a asp-controller="EnrollmentApplications" asp-action="Browse" class="sidebar-link @(ctrl=="EnrollmentApplications"&&action=="Browse"?"active":"")">  
                        <i class="fa-solid fa-compass fa-fw"></i> Browse Courses
                    </a>
                    <a asp-controller="EnrollmentApplications" asp-action="MyApplications" class="sidebar-link @(ctrl=="EnrollmentApplications"&&action=="MyApplications"?"active":"")">  
                        <i class="fa-solid fa-file-circle-check fa-fw"></i> My Applications
                    </a>
                    <a asp-controller="AssignmentSubmissions" asp-action="MyGrades" class="sidebar-link @(ctrl=="AssignmentSubmissions"&&action=="MyGrades"?"active":"")">
                        <i class="fa-solid fa-chart-bar fa-fw"></i> My Grades
                    </a>
                }
                <a asp-controller="Exams" asp-action="Index" class="sidebar-link @(ctrl=="Exams"?"active":"")">
                    <i class="fa-solid fa-pen-to-square fa-fw"></i> Exams
                </a>
                @if (role == "student")
                {
                    <a asp-controller="ExamResults" asp-action="Index" class="sidebar-link @(ctrl=="ExamResults"?"active":"")">
                        <i class="fa-solid fa-trophy fa-fw"></i> Exam Results
                    </a>
                }
                <a asp-controller="Announcements" asp-action="Index" class="sidebar-link @(ctrl=="Announcements"?"active":"")">
                    <i class="fa-solid fa-bullhorn fa-fw"></i> Announcements
                </a>

                @if (role == "administrator")
                {
                    <div class="pt-4 pb-1 px-3" style="font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.35);">Administration</div>
                    <a asp-controller="Users" asp-action="Index" class="sidebar-link @(ctrl=="Users"?"active":"")">
                        <i class="fa-solid fa-users fa-fw"></i> Users
                    </a>
                    <a asp-controller="Departments" asp-action="Index" class="sidebar-link @(ctrl=="Departments"?"active":"")">
                        <i class="fa-solid fa-building fa-fw"></i> Departments
                    </a>
                    <a asp-controller="Batches" asp-action="Index" class="sidebar-link @(ctrl=="Batches"?"active":"")">
                        <i class="fa-solid fa-people-group fa-fw"></i> Batches
                    </a>
                    <a asp-controller="Enrollments" asp-action="Index" class="sidebar-link @(ctrl=="Enrollments"?"active":"")">  
                        <i class="fa-solid fa-user-plus fa-fw"></i> Enrollments
                    </a>
                    <a asp-controller="EnrollmentApplications" asp-action="Index" class="sidebar-link @(ctrl=="EnrollmentApplications"?"active":"")">  
                        <i class="fa-solid fa-inbox fa-fw"></i> Applications
                    </a>
                    <a asp-controller="Roles" asp-action="Index" class="sidebar-link @(ctrl=="Roles"?"active":"")">
                        <i class="fa-solid fa-shield-halved fa-fw"></i> Roles
                    </a>
                    <a asp-controller="ExamResults" asp-action="Index" class="sidebar-link @(ctrl=="ExamResults"?"active":"")">  
                        <i class="fa-solid fa-ranking-star fa-fw"></i> Exam Results
                    </a>
                    <a asp-controller="Reports" asp-action="Index" class="sidebar-link @(ctrl=="Reports"?"active":"")">  
                        <i class="fa-solid fa-chart-line fa-fw"></i> Reports
                    </a>
                }
                @if (role == "lecturer")
                {
                    <div class="pt-4 pb-1 px-3" style="font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.35);">Management</div>
                    <a asp-controller="AssignmentSubmissions" asp-action="Index" asp-route-assignmentId="0" class="sidebar-link @(ctrl=="AssignmentSubmissions"&&action!="MyGrades"?"active":"")">
                        <i class="fa-solid fa-inbox fa-fw"></i> Submissions
                    </a>
                    <a asp-controller="ExamResults" asp-action="Index" class="sidebar-link @(ctrl=="ExamResults"?"active":"")">
                        <i class="fa-solid fa-ranking-star fa-fw"></i> Exam Results
                    </a>
                    <a asp-controller="Reports" asp-action="Index" class="sidebar-link @(ctrl=="Reports"?"active":"")">  
                        <i class="fa-solid fa-chart-line fa-fw"></i> Reports
                    </a>
                }
            </nav>

            <!-- User footer -->
            <div class="p-4" style="border-top:1px solid rgba(255,255,255,0.08);">
                <a asp-controller="Account" asp-action="Logout"
                   class="flex items-center gap-2 text-sm text-white transition-colors px-3 py-2 rounded-md bg-red-500 hover:bg-red-600">
                    <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                </a>
            </div>
        </aside>

        <!-- Main -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Top bar -->
            <header class="h-16 bg-white flex items-center justify-between px-6 flex-shrink-0" style="border-bottom:1px solid #e8edf5;">
                <div class="flex items-center gap-3">
                    <div class="w-1 h-6 rounded-full bg-blue-700"></div>
                    <h1 class="text-base text-slate-800">@ViewData["Title"]</h1>
                </div>
                <div class="flex items-center gap-3">
                    @if (TempData["Success"] != null)
                    {
                        <div class="toast-success">
                            <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="toast-error">
                            <i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]
                        </div>
                    }
                    <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-full px-3 py-1.5">
                        <div class="w-6 h-6 rounded-full bg-blue-700 flex items-center justify-center text-xs text-white font-semibold flex-shrink-0">
                            @((ViewBag.CurrentUserName as string ?? "?")[0].ToString().ToUpper())
                        </div>
                        <div class="hidden sm:flex flex-col leading-none gap-0.5">
                            <span class="text-xs font-medium text-slate-700">@ViewBag.CurrentUserName</span>
                            @{
                                var roleName = ViewBag.CurrentUserRole as string ?? "";
                                var (roleLabel, roleBg, roleText) = roleName switch {
                                    "administrator" => ("Administrator", "bg-purple-100", "text-purple-700"),
                                    "lecturer"      => ("Lecturer",      "bg-blue-100",   "text-blue-700"),
                                    _               => ("Student",       "bg-emerald-100","text-emerald-700")
                                };
                            }
                            <span class="inline-flex items-center gap-1 text-[0.6rem] font-semibold leading-none px-1.5 py-0.5 rounded-full @roleBg @roleText">
                                @if (roleName == "administrator") {
                                    <i class="fa-solid fa-shield-halved" style="font-size:0.55rem;"></i>
                                } else if (roleName == "lecturer") {
                                    <i class="fa-solid fa-chalkboard-user" style="font-size:0.55rem;"></i>
                                } else {
                                    <i class="fa-solid fa-user-graduate" style="font-size:0.55rem;"></i>
                                }
                                @roleLabel
                            </span>
                        </div>
                    </div>
                </div>
            </header>
            <main class="flex-1 overflow-y-auto p-6 bg-slate-100">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
// Client-side form validation
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('form[data-val="true"], form.needs-validation').forEach(function (form) {
        var inputs = form.querySelectorAll('input:not([type=hidden]):not([type=checkbox]), select, textarea');
        inputs.forEach(function (inp) {
            inp.addEventListener('blur', function () { validateInput(inp); });
            inp.addEventListener('input', function () { if (inp.classList.contains('input-error')) validateInput(inp); });
        });
        form.addEventListener('submit', function (e) {
            var ok = true;
            inputs.forEach(function (inp) { if (!validateInput(inp)) ok = false; });
            if (!ok) e.preventDefault();
        });
    });
    function validateInput(inp) {
        var err = inp.parentElement.querySelector('.field-error');
        if (!inp.validity.valid) {
            inp.classList.add('input-error'); inp.classList.remove('input-valid');
            if (!err) { err = document.createElement('p'); err.className = 'field-error'; inp.parentElement.appendChild(err); }
            err.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> ' + inp.validationMessage;
            return false;
        } else {
            inp.classList.remove('input-error'); if (inp.value) inp.classList.add('input-valid');
            if (err) err.remove(); return true;
        }
    }
});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
