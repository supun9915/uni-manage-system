@model UniManage.Models.ModuleModel
@{
    ViewData["Title"] = "Delete Module";
}
<div class="max-w-lg">
    <div class="page-card">
        <div class="flex items-start gap-4 mb-5">
            <div class="w-12 h-12 rounded-xl bg-red-50 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-triangle-exclamation text-red-600 text-xl"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Delete Module</h2>
                <p class="text-sm text-slate-500 mt-0.5">This will also remove associated materials and assignments.</p>
            </div>
        </div>
        <div class="bg-red-50 border border-red-100 rounded-lg p-4 mb-5 text-sm space-y-2">
            <p><span class="text-slate-500"><i class="fa-solid fa-layer-group mr-1"></i>Module:</span> <strong class="text-slate-800">@Model.Title</strong></p>
            <p><span class="text-slate-500"><i class="fa-solid fa-book-open mr-1"></i>Course:</span> <span class="text-slate-700">@Model.Course?.Title</span></p>
        </div>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="flex gap-3">
                <button type="submit" class="btn-danger"><i class="fa-solid fa-trash"></i> Delete Permanently</button>
                <a asp-action="Index" class="btn-secondary"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>
