@model UniManage.Models.ModuleModel
@{
    ViewData["Title"] = "Edit Module";
}
<div class="max-w-lg">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-base font-semibold text-gray-800 mb-5">Edit Module</h2>
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-4">
                <label asp-for="CourseId" class="block text-sm font-medium text-gray-700 mb-1">Course</label>
                <select asp-for="CourseId" asp-items="ViewBag.Courses" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"></select>
            </div>
            <div class="mb-4">
                <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Title" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div class="mb-4">
                <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <textarea asp-for="Description" rows="2" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
            </div>
            <div class="mb-4">
                <label asp-for="OrderIndex" class="block text-sm font-medium text-gray-700 mb-1">Order</label>
                <input asp-for="OrderIndex" type="number" min="1" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div class="mb-6 flex items-center gap-2">
                <input asp-for="IsPublished" type="checkbox" class="w-4 h-4 text-indigo-600 rounded" />
                <label asp-for="IsPublished" class="text-sm text-gray-700">Published</label>
            </div>
            <div class="flex gap-3">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors">Save</button>
                <a asp-action="Index" class="text-sm font-medium text-gray-500 hover:text-gray-700 px-5 py-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
