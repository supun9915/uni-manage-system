@model UniManage.Models.ModuleModel
@{
    ViewData["Title"] = "Edit Module";
}
<div class="max-w-lg">
    <div class="page-card">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center">
                <i class="fa-solid fa-layer-group text-amber-600"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Edit Module</h2>
                <p class="text-xs text-slate-400">Update module details</p>
            </div>
        </div>
        <form asp-action="Edit" method="post" data-val="true">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-4">
                <label asp-for="CourseId" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-book-open mr-1"></i>Course</label>
                <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-input"></select>
            </div>
            <div class="mb-4">
                <label asp-for="Title" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-heading mr-1"></i></label>
                <input asp-for="Title" class="form-input" required />
            </div>
            <div class="mb-4">
                <label asp-for="Description" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-align-left mr-1"></i></label>
                <textarea asp-for="Description" rows="2" class="form-input"></textarea>
            </div>
            <div class="mb-4">
                <label asp-for="OrderIndex" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-sort-numeric-up mr-1"></i>Order</label>
                <input asp-for="OrderIndex" type="number" min="1" class="form-input" />
            </div>
            <div class="mb-6 flex items-center gap-2.5 p-3 bg-slate-50 rounded-lg">
                <input asp-for="IsPublished" type="checkbox" class="w-4 h-4 rounded accent-blue-700" />
                <label asp-for="IsPublished" class="text-sm text-slate-600 font-medium cursor-pointer"><i class="fa-solid fa-eye mr-1 text-emerald-500"></i>Publish module</label>
            </div>
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
                <a asp-action="Index" class="btn-secondary"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>
