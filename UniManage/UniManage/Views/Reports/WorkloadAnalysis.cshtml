@using UniManage.Models
@using UniManage.ViewModels
@{
    ViewData["Title"] = "Workload Analysis Report";
    var modules = ViewBag.Modules as List<ModuleModel> ?? new();
    DateTime generatedAt = ViewBag.GeneratedAt ?? DateTime.Now;
    var role = ViewBag.CurrentUserRole as string;
}

<div class="space-y-4">
    <!-- Toolbar -->
    <div class="flex items-center justify-between">
        <a asp-controller="Reports" asp-action="Index" class="btn-secondary text-xs">
            <i class="fa-solid fa-arrow-left"></i> Back to Reports
        </a>
        <button onclick="downloadPdf()" class="btn-primary text-xs">
            <i class="fa-solid fa-file-pdf"></i> Download PDF
        </button>
    </div>

    <!-- Report Content -->
    <div id="report-content" class="space-y-6">
        <!-- Header -->
        <div class="page-card">
            <div class="border-b border-slate-100 pb-5 mb-5">
                <div class="flex items-center gap-2 mb-1">
                    <div class="w-7 h-7 rounded-lg bg-blue-700 flex items-center justify-center">
                        <i class="fa-solid fa-graduation-cap text-white text-xs"></i>
                    </div>
                    <span class="text-sm font-semibold text-blue-800">UniManage</span>
                </div>
                <h1 class="text-xl font-bold text-slate-800 mt-2">Workload Analysis Report</h1>
                <p class="text-xs text-slate-400 mt-0.5">Generated on @generatedAt.ToString("dd MMMM yyyy, HH:mm")</p>
            </div>

            <!-- Summary Cards -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="bg-blue-50 rounded-xl p-4 text-center">
                    <p class="text-xs text-slate-500 mb-1">Total Modules</p>
                    <p class="text-2xl font-bold text-blue-700">@modules.Count</p>
                </div>
                <div class="bg-emerald-50 rounded-xl p-4 text-center">
                    <p class="text-xs text-slate-500 mb-1">Total Assignments</p>
                    <p class="text-2xl font-bold text-emerald-600">@modules.Sum(m => m.Assignments.Count)</p>
                </div>
                <div class="bg-amber-50 rounded-xl p-4 text-center">
                    <p class="text-xs text-slate-500 mb-1">Total Exams</p>
                    <p class="text-2xl font-bold text-amber-600">@modules.Sum(m => m.Exams.Count)</p>
                </div>
                <div class="bg-purple-50 rounded-xl p-4 text-center">
                    <p class="text-xs text-slate-500 mb-1">Total Materials</p>
                    <p class="text-2xl font-bold text-purple-600">@modules.Sum(m => m.CourseMaterials.Count)</p>
                </div>
            </div>
        </div>

        @if (role == "administrator")
        {
            <!-- Lecturer Workload Summary (admin only) -->
            <div class="page-card">
                <h2 class="text-sm font-semibold text-slate-700 mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-chalkboard-user text-blue-700"></i> Lecturer Workload Summary
                </h2>
                @{
                    var workloadList = ViewBag.LecturerWorkload as List<LecturerWorkloadItem>;
                }
                @if (workloadList == null || !workloadList.Any())
                {
                    <p class="text-xs text-slate-400 py-4 text-center">No lecturer data found.</p>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="table-header">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Lecturer</th>
                                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Modules</th>
                                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Assignments</th>
                                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Exams</th>
                                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Materials</th>
                                    <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Total Items</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var w in workloadList)
                                {
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="px-4 py-3">
                                            <div class="flex items-center gap-2">
                                                <div class="w-7 h-7 rounded-full bg-blue-700 flex items-center justify-center text-white text-xs flex-shrink-0">
                                                    @w.Lecturer.FirstName[0]
                                                </div>
                                                <span class="text-slate-800">@w.Lecturer.FirstName @w.Lecturer.LastName</span>
                                            </div>
                                        </td>
                                        <td class="px-4 py-3 font-semibold text-blue-700">@w.ModuleCount</td>
                                        <td class="px-4 py-3 text-slate-600">@w.AssignmentCount</td>
                                        <td class="px-4 py-3 text-slate-600">@w.ExamCount</td>
                                        <td class="px-4 py-3 text-slate-600">@w.MaterialCount</td>
                                        <td class="px-4 py-3">
                                            <span class="font-semibold text-emerald-600">@w.TotalItems</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        <!-- Module-level Breakdown -->
        <div class="page-card">
            <h2 class="text-sm font-semibold text-slate-700 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-layer-group text-amber-600"></i> Module Breakdown
            </h2>
            @if (!modules.Any())
            {
                <p class="text-xs text-slate-400 py-4 text-center">No modules found.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="table-header">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Module</th>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Course</th>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Lecturer</th>
                                <th class="px-4 py-3 text-center text-xs text-white uppercase tracking-wider">Assignments</th>
                                <th class="px-4 py-3 text-center text-xs text-white uppercase tracking-wider">Exams</th>
                                <th class="px-4 py-3 text-center text-xs text-white uppercase tracking-wider">Materials</th>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Published</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var m in modules)
                            {
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-4 py-3 text-slate-800 font-medium">@m.Title</td>
                                    <td class="px-4 py-3 text-slate-500 text-xs">@(m.Course?.Title ?? "—")</td>
                                    <td class="px-4 py-3 text-slate-500 text-xs">
                                        @(m.Lecturer != null ? $"{m.Lecturer.FirstName} {m.Lecturer.LastName}" : "Unassigned")
                                    </td>
                                    <td class="px-4 py-3 text-center font-semibold text-blue-700">@m.Assignments.Count</td>
                                    <td class="px-4 py-3 text-center font-semibold text-amber-600">@m.Exams.Count</td>
                                    <td class="px-4 py-3 text-center font-semibold text-purple-600">@m.CourseMaterials.Count</td>
                                    <td class="px-4 py-3">
                                        @if (m.IsPublished)
                                        {
                                            <span class="status-badge bg-emerald-50 text-emerald-700">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge bg-slate-100 text-slate-500">No</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <p class="text-xs text-slate-400 text-right pt-4 border-t border-slate-100 mt-4">UniManage &mdash; Confidential</p>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    function downloadPdf() {
        const element = document.getElementById('report-content');
        const opt = {
            margin: [10, 10, 10, 10],
            filename: 'workload-analysis-report-@(generatedAt.ToString("yyyyMMdd-HHmm")).pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, logging: false },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
        };
        html2pdf().set(opt).from(element).save();
    }
</script>
