@using UniManage.Models
@{
    ViewData["Title"] = "Student Performance Report";
    var courses = ViewBag.Courses as List<CourseModel> ?? new();
    var examResults = ViewBag.ExamResults as List<ExamResultModel> ?? new();
    var submissions = ViewBag.Submissions as List<AssignmentSubmissionModel> ?? new();
    int? selectedCourseId = ViewBag.SelectedCourseId;
    DateTime generatedAt = ViewBag.GeneratedAt ?? DateTime.Now;

    var passCount = examResults.Count(r => r.Status == "pass");
    var avgMark = examResults.Any(r => r.MarksObtained.HasValue)
        ? examResults.Where(r => r.MarksObtained.HasValue).Average(r => r.MarksObtained!.Value)
        : 0.0;
    var avgGrade = submissions.Any() ? submissions.Average(s => (double)s.MarksObtained!.Value) : 0.0;
}

<div class="space-y-4">
    <!-- Toolbar -->
    <div class="flex items-center justify-between flex-wrap gap-3">
        <a asp-controller="Reports" asp-action="Index" class="btn-secondary text-xs">
            <i class="fa-solid fa-arrow-left"></i> Back to Reports
        </a>
        <div class="flex items-center gap-3">
            <form method="get" asp-controller="Reports" asp-action="StudentPerformance" class="flex items-center gap-2">
                <select name="courseId" onchange="this.form.submit()" class="form-input text-xs py-2 w-52">
                    <option value="">— All Courses —</option>
                    @foreach (var c in courses)
                    {
                        if (selectedCourseId == c.Id)
                        {
                            <option value="@c.Id" selected>@c.Title</option>
                        }
                        else
                        {
                            <option value="@c.Id">@c.Title</option>
                        }
                    }
                </select>
            </form>
            <button onclick="downloadPdf()" class="btn-primary text-xs">
                <i class="fa-solid fa-file-pdf"></i> Download PDF
            </button>
        </div>
    </div>

    <!-- Report Content -->
    <div id="report-content" class="space-y-6">
        <!-- Header card -->
        <div class="page-card">
            <div class="border-b border-slate-100 pb-5 mb-5">
                <div class="flex items-center gap-2 mb-1">
                    <div class="w-7 h-7 rounded-lg bg-blue-700 flex items-center justify-center">
                        <i class="fa-solid fa-graduation-cap text-white text-xs"></i>
                    </div>
                    <span class="text-sm font-semibold text-blue-800">UniManage</span>
                </div>
                <h1 class="text-xl font-bold text-slate-800 mt-2">Student Performance Report</h1>
                <p class="text-xs text-slate-400 mt-0.5">Generated on @generatedAt.ToString("dd MMMM yyyy, HH:mm")</p>
                @if (selectedCourseId.HasValue)
                {
                    var selectedCourse = courses.FirstOrDefault(c => c.Id == selectedCourseId);
                    <p class="text-xs text-blue-700 mt-1">Filtered by: <strong>@selectedCourse?.Title</strong></p>
                }
            </div>

            <!-- Summary -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="bg-blue-50 rounded-xl p-4 text-center">
                    <p class="text-xs text-slate-500 mb-1">Exam Results</p>
                    <p class="text-2xl font-bold text-blue-700">@examResults.Count</p>
                </div>
                <div class="bg-emerald-50 rounded-xl p-4 text-center">
                    <p class="text-xs text-slate-500 mb-1">Pass Rate</p>
                    <p class="text-2xl font-bold text-emerald-600">
                        @(examResults.Count > 0 ? ((double)passCount / examResults.Count * 100).ToString("F0") : "0")%
                    </p>
                </div>
                <div class="bg-amber-50 rounded-xl p-4 text-center">
                    <p class="text-xs text-slate-500 mb-1">Avg. Exam Mark</p>
                    <p class="text-2xl font-bold text-amber-600">@avgMark.ToString("F1")</p>
                </div>
                <div class="bg-purple-50 rounded-xl p-4 text-center">
                    <p class="text-xs text-slate-500 mb-1">Avg. Assignment Grade</p>
                    <p class="text-2xl font-bold text-purple-600">@avgGrade.ToString("F1")</p>
                </div>
            </div>
        </div>

        <!-- Exam Results Table -->
        <div class="page-card">
            <h2 class="text-sm font-semibold text-slate-700 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-pen-to-square text-blue-700"></i> Exam Results
            </h2>
            @if (!examResults.Any())
            {
                <p class="text-xs text-slate-400 py-4 text-center">No exam results found.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="table-header">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Student</th>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Exam</th>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Course</th>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Marks</th>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var r in examResults.OrderBy(r => r.Student?.FirstName))
                            {
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-4 py-3 text-slate-800">@r.Student?.FirstName @r.Student?.LastName</td>
                                    <td class="px-4 py-3 text-slate-600 text-xs">@r.Exam?.Title</td>
                                    <td class="px-4 py-3 text-slate-500 text-xs">@(r.Exam?.Module?.Course?.Title ?? "—")</td>
                                    <td class="px-4 py-3">
                                        <span class="font-semibold text-blue-700">@(r.MarksObtained?.ToString() ?? "—")</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        @{
                                            var (bg, _) = r.Status switch
                                            {
                                                "pass" => ("bg-emerald-50 text-emerald-700", ""),
                                                "fail" => ("bg-red-50 text-red-700", ""),
                                                "absent" => ("bg-slate-100 text-slate-600", ""),
                                                _ => ("bg-slate-100 text-slate-600", "")
                                            };
                                        }
                                        <span class="status-badge @bg">@(r.Status ?? "—")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Assignment Grades Table -->
        <div class="page-card">
            <h2 class="text-sm font-semibold text-slate-700 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-clipboard-check text-emerald-600"></i> Assignment Grades
            </h2>
            @if (!submissions.Any())
            {
                <p class="text-xs text-slate-400 py-4 text-center">No graded submissions found.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="table-header">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Student</th>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Assignment</th>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Course</th>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Marks</th>
                                <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Submitted</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var s in submissions.OrderBy(s => s.Student?.FirstName))
                            {
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-4 py-3 text-slate-800">@s.Student?.FirstName @s.Student?.LastName</td>
                                    <td class="px-4 py-3 text-slate-600 text-xs">@s.Assignment?.Title</td>
                                    <td class="px-4 py-3 text-slate-500 text-xs">@(s.Assignment?.Module?.Course?.Title ?? "—")</td>
                                    <td class="px-4 py-3">
                                        <span class="font-semibold text-emerald-700">@(s.MarksObtained?.ToString() ?? "—")</span>
                                    </td>
                                    <td class="px-4 py-3 text-slate-400 text-xs">@s.SubmittedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <p class="text-xs text-slate-400 text-right pt-4 border-t border-slate-100 mt-4">UniManage &mdash; Confidential</p>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    function downloadPdf() {
        const element = document.getElementById('report-content');
        const opt = {
            margin: [10, 10, 10, 10],
            filename: 'student-performance-report-@(generatedAt.ToString("yyyyMMdd-HHmm")).pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, logging: false },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };
        html2pdf().set(opt).from(element).save();
    }
</script>
