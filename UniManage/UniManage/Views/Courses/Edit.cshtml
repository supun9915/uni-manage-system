@model UniManage.Models.CourseModel
@{
    ViewData["Title"] = "Edit Course";
}
<div class="max-w-xl">
    <div class="page-card">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center">
                <i class="fa-solid fa-book-open text-amber-600"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Edit Course</h2>
                <p class="text-xs text-slate-400">Update course information</p>
            </div>
        </div>
        <form asp-action="Edit" method="post" data-val="true">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-4">
                <label asp-for="Title" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-heading mr-1"></i></label>
                <input asp-for="Title" class="form-input" required />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="Code" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-tag mr-1"></i></label>
                    <input asp-for="Code" class="form-input" />
                </div>
                <div>
                    <label asp-for="DepartmentId" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-building mr-1"></i>Department</label>
                    <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-input"></select>
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="Description" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-align-left mr-1"></i></label>
                <textarea asp-for="Description" rows="3" class="form-input"></textarea>
            </div>
            <div class="mb-6">
                <label asp-for="Status" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-circle-dot mr-1"></i></label>
                <select asp-for="Status" class="form-input">
                    <option value="draft">Draft</option>
                    <option value="published">Published</option>
                    <option value="archived">Archived</option>
                </select>
            </div>
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
                <a asp-action="Index" class="btn-secondary"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>
