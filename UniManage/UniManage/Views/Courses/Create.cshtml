@model UniManage.Models.CourseModel
@{
    ViewData["Title"] = "Create Course";
}
<div class="max-w-xl mx-auto">
    <div class="page-card">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
                <i class="fa-solid fa-book-medical text-blue-700"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Create Course</h2>
                <p class="text-xs text-slate-400">Add a new course to the catalogue</p>
            </div>
        </div>
        <form asp-action="Create" method="post" data-val="true">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label asp-for="Title" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-heading mr-1"></i>Course Title</label>
                <input asp-for="Title" class="form-input" placeholder="Course title" required />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="Code" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-tag mr-1"></i>Code</label>
                    <input asp-for="Code" class="form-input" placeholder="e.g. CS101" required />
                    <span asp-validation-for="Code" class="field-error"></span>
                </div>
                <div>
                    <label asp-for="DepartmentId" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-building mr-1"></i>Department</label>
                    <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-input" required>
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="field-error"></span>
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="Description" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-align-left mr-1"></i>Description</label>
                <textarea asp-for="Description" rows="3" class="form-input" placeholder="Course description"></textarea>
            </div>
            <div class="mb-6">
                <label asp-for="Status" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-circle-dot mr-1"></i>Status</label>
                <select asp-for="Status" class="form-input">
                    <option value="draft">Draft</option>
                    <option value="published">Published</option>
                    <option value="archived">Archived</option>
                </select>
            </div>
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="text-sm bg-blue-900 hover:bg-blue-950 px-8 py-1 text-white rounded-lg border border-blue-900"><i class="fa-solid fa-floppy-disk"></i> Create</button>
                <a asp-action="Index" class="btn-secondary py-1"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>
