@model IEnumerable<UniManage.Models.ExamModel>
@{
    ViewData["Title"] = "Exams";
    var role = ViewBag.CurrentUserRole as string;
}
<div class="page-card">
    <div class="flex items-center justify-between mb-5">
        <h2 class="text-sm text-slate-700 flex items-center gap-2">
            <i class="fa-solid fa-file-pen text-blue-700"></i> Exams
        </h2>
        @if (role != "student")
        {
            <a asp-action="Create" class="text-sm bg-blue-900 px-8 py-1 text-white rounded-lg border border-blue-700"><i class="fa-solid fa-plus text-sm"></i> Add Exam</a>
        }
    </div>
    @if (!Model.Any())
    {
        <div class="flex flex-col items-center py-12 text-slate-400">
            <i class="fa-solid fa-file-pen text-4xl mb-3 opacity-30"></i>
            <p class="text-sm">No exams found.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="table-header">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-heading mr-1"></i>Title</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-layer-group mr-1"></i>Module</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-book mr-1"></i>Course</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-calendar mr-1"></i>Exam Date</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-star mr-1"></i>Total Marks</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-clock mr-1"></i>Duration</th>
                        @if (role != "student")
                        {
                            <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var e in Model)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 font-medium text-slate-800">@e.Title</td>
                            <td class="px-4 py-3 text-slate-600">@e.Module?.Title</td>
                            <td class="px-4 py-3 text-slate-600">@e.Module?.Course?.Title</td>
                            <td class="px-4 py-3 text-slate-400">@(e.ExamDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                            <td class="px-4 py-3 text-slate-600">@e.TotalMarks</td>
                            <td class="px-4 py-3 text-slate-400">@(e.DurationMinutes.HasValue ? $"{e.DurationMinutes} min" : "—")</td>
                            @if (role != "student")
                            {
                                <td class="px-4 py-3">
                                    <div class="flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@e.Id" class="text-xs bg-blue-50 text-blue-700 px-3 py-1 rounded-full hover:bg-blue-100">
                                            <i class="fa-solid fa-pen text-xs mr-0.5"></i>Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@e.Id" class="text-xs bg-red-50 text-red-700 px-3 py-1 rounded-full hover:bg-red-100">
                                            <i class="fa-solid fa-trash text-xs mr-0.5"></i>Delete
                                        </a>
                                        <a asp-controller="ExamResults" asp-action="Index" asp-route-examId="@e.Id" class="text-xs bg-slate-100 text-slate-600 px-3 py-1 rounded-full hover:bg-slate-200">
                                            <i class="fa-solid fa-chart-bar text-xs mr-0.5"></i>Results
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
