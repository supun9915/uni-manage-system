@model UniManage.Models.ExamModel
@{
    ViewData["Title"] = "Delete Exam";
}
<div class="max-w-md mx-auto">
    <div class="page-card">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center">
                <i class="fa-solid fa-trash text-red-600"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Delete Exam</h2>
                <p class="text-xs text-slate-400">This action cannot be undone</p>
            </div>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 mb-6 space-y-2 text-sm text-slate-700">
            <p><span class="text-xs text-slate-400 uppercase tracking-wide">Title:</span> @Model.Title</p>
            <p><span class="text-xs text-slate-400 uppercase tracking-wide">Module:</span> @Model.Module?.Title</p>
            <p><span class="text-xs text-slate-400 uppercase tracking-wide">Exam Date:</span> @(Model.ExamDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</p>
            <p><span class="text-xs text-slate-400 uppercase tracking-wide">Total Marks:</span> @Model.TotalMarks</p>
        </div>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="text-sm bg-red-600 hover:bg-red-700 px-6 py-1 text-white rounded-lg border border-red-600"><i class="fa-solid fa-trash"></i> Delete</button>
                <a asp-action="Index" class="btn-secondary py-1"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>
