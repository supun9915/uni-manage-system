@model UniManage.Models.RoleModel
@{
    ViewData["Title"] = "Delete Role";
}

<div class="max-w-lg mx-auto">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-base text-gray-800 mb-2">Delete Role</h2>
        <p class="text-sm text-gray-500 mb-5">Are you sure you want to delete <strong>@Model.Name</strong>?</p>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="text-sm bg-red-600 hover:bg-red-700 px-6 py-1 text-white rounded-lg border border-red-600"><i class="fa-solid fa-trash"></i> Delete</button>
                <a asp-action="Index" class="btn-secondary py-1"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>
