@model IEnumerable<UniManage.Models.RoleModel>
@{
    ViewData["Title"] = "Roles";
}
<div class="page-card">
    <div class="flex items-center justify-between mb-5">
        <h2 class="text-sm text-slate-700 flex items-center gap-2">
            <i class="fa-solid fa-shield-halved text-blue-700"></i> Roles
        </h2>
        <a asp-action="Create" class="text-sm bg-blue-900 px-8 py-1 text-white rounded-lg border border-blue-700"><i class="fa-solid fa-plus text-sm"></i> New Role</a>
    </div>
    @if (!Model.Any())
    {
        <div class="flex flex-col items-center py-12 text-slate-400">
            <i class="fa-solid fa-shield-halved text-4xl mb-3 opacity-30"></i>
            <p class="text-sm">No roles found.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="table-header">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-hashtag mr-1"></i>ID</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-tag mr-1"></i>Name</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-align-left mr-1"></i>Description</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-users mr-1"></i>Users</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var r in Model)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 text-slate-400">@r.Id</td>
                            <td class="px-4 py-3 font-medium text-slate-800">@r.Name</td>
                            <td class="px-4 py-3 text-slate-500">@(r.Description ?? "—")</td>
                            <td class="px-4 py-3 text-slate-600">@r.Users.Count</td>
                            <td class="px-4 py-3">
                                <div class="flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="text-xs bg-blue-50 text-blue-700 px-3 py-1 rounded-full hover:bg-blue-100">
                                        <i class="fa-solid fa-pen text-xs mr-0.5"></i>Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@r.Id" class="text-xs bg-red-50 text-red-700 px-3 py-1 rounded-full hover:bg-red-100">
                                        <i class="fa-solid fa-trash text-xs mr-0.5"></i>Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
