@model UniManage.Models.ExamResultModel
@{
    ViewData["Title"] = "Add Exam Result";
    var exam = ViewBag.Exam as UniManage.Models.ExamModel;
}
<div class="max-w-xl mx-auto">
    <div class="page-card">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
                <i class="fa-solid fa-chart-bar text-blue-700"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Add Exam Result</h2>
                @if (exam != null)
                {
                    <p class="text-xs text-slate-400"><i class="fa-solid fa-file-pen mr-1"></i>@exam.Title &mdash; @exam.Module?.Course?.Title</p>
                }
            </div>
        </div>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ExamId" />
            <div asp-validation-summary="ModelOnly" class="text-xs text-red-600 mb-4"></div>
            <div class="mb-4">
                <label asp-for="StudentId" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-user mr-1"></i>Student</label>
                <select asp-for="StudentId" asp-items="ViewBag.Students" class="form-input" required>
                    <option value="">-- Select Student --</option>
                </select>
                <span asp-validation-for="StudentId" class="field-error"></span>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-6">
                <div>
                    <label asp-for="MarksObtained" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-star mr-1"></i>Marks Obtained</label>
                    <input asp-for="MarksObtained" type="number" min="0" max="@exam?.TotalMarks" class="form-input" placeholder="0" />
                    <span asp-validation-for="MarksObtained" class="field-error"></span>
                </div>
                <div>
                    <label asp-for="Status" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-circle-dot mr-1"></i>Status</label>
                    <select asp-for="Status" class="form-input">
                        <option value="">-- Auto --</option>
                        <option value="pass">Pass</option>
                        <option value="fail">Fail</option>
                        <option value="absent">Absent</option>
                    </select>
                </div>
            </div>
            <div class="flex gap-3">
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-plus mr-1"></i> Save Result
                </button>
                <a asp-action="Index" asp-route-examId="@Model.ExamId" class="btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
