@model UniManage.Models.AnnouncementModel
@{
    ViewData["Title"] = "Edit Announcement";
}
<div class="max-w-xl mx-auto">
    <div class="page-card">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
                <i class="fa-solid fa-bullhorn text-blue-700"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Edit Announcement</h2>
                <p class="text-xs text-slate-400">Update announcement details</p>
            </div>
        </div>
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-xs text-red-600 mb-4"></div>
            <div class="mb-4">
                <label asp-for="CourseId" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-book mr-1"></i>Course</label>
                <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-input" required>
                    <option value="">-- Select Course --</option>
                </select>
                <span asp-validation-for="CourseId" class="field-error"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Title" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-heading mr-1"></i>Title</label>
                <input asp-for="Title" class="form-input" required />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Content" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-align-left mr-1"></i>Content</label>
                <textarea asp-for="Content" rows="4" class="form-input" required></textarea>
                <span asp-validation-for="Content" class="field-error"></span>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-6">
                <div>
                    <label asp-for="TargetRole" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-users mr-1"></i>Target Audience</label>
                    <select asp-for="TargetRole" asp-items="ViewBag.TargetRoles" class="form-input">
                        <option value="">-- All --</option>
                    </select>
                </div>
                <div>
                    <label asp-for="PublishDate" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-calendar-check mr-1"></i>Publish Date</label>
                    <input asp-for="PublishDate" type="datetime-local" class="form-input" />
                </div>
            </div>
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="text-sm bg-blue-900 hover:bg-blue-950 px-8 py-1 text-white rounded-lg border border-blue-900"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
                <a asp-action="Index" class="btn-secondary py-1"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>
