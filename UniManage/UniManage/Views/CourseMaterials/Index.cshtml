@model IEnumerable<UniManage.Models.CourseMaterialModel>
@{
    ViewData["Title"] = "Course Materials";
    var role = ViewBag.CurrentUserRole as string;
}
<div class="page-card">
    <div class="flex items-center justify-between mb-5">
        <h2 class="text-sm text-slate-700 flex items-center gap-2">
            <i class="fa-solid fa-file-lines text-blue-700"></i> Course Materials
        </h2>
        @if (role != "student")
        {
            <a asp-action="Create" asp-route-moduleId="@ViewBag.ModuleId" class="text-sm bg-blue-900 px-8 py-1 text-white rounded-lg border border-blue-700"><i class="fa-solid fa-upload text-sm"></i> Upload Material</a>
        }
    </div>
    @if (!Model.Any())
    {
        <p class="text-sm text-gray-400 py-4">No materials found.</p>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var m in Model)
            {
                <div class="border border-gray-100 rounded-xl p-4 hover:shadow-md transition-shadow">
                    <div class="flex items-center gap-3 mb-2">
                        @{
                            var (iconClass, iconColor) = m.FileType?.ToLower() switch {
                                "pdf"                    => ("fa-solid fa-file-pdf",        "text-red-500"),
                                "video" or "mp4" or "avi"=> ("fa-solid fa-circle-play",     "text-purple-500"),
                                "link"  or "url"         => ("fa-solid fa-link",             "text-blue-500"),
                                "pptx"  or "ppt"         => ("fa-solid fa-file-powerpoint",  "text-orange-500"),
                                "docx"  or "doc"         => ("fa-solid fa-file-word",        "text-blue-700"),
                                "xlsx"  or "xls"         => ("fa-solid fa-file-excel",       "text-green-600"),
                                "zip"   or "rar"         => ("fa-solid fa-file-zipper",      "text-yellow-600"),
                                _                        => ("fa-solid fa-file-lines",       "text-slate-400")
                            };
                        }
                        <span class="text-2xl"><i class="@iconClass @iconColor"></i></span>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-800 truncate">@m.Title</p>
                            <p class="text-xs text-gray-400">@m.Module?.Course?.Title � @m.Module?.Title</p>
                        </div>
                    </div>
                    <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-50">
                        <span class="text-xs text-gray-400">@m.UploadedAt.ToString("dd MMM yyyy")</span>
                        <div class="flex gap-2">
                            <a asp-action="Download" asp-route-id="@m.Id" class="text-xs bg-indigo-50 text-indigo-600 px-3 py-1 rounded-full hover:bg-indigo-100">
                                <i class="fa-solid fa-download text-xs mr-0.5"></i>Download
                            </a>
                            @if (role != "student")
                            {
                                <a asp-action="Delete" asp-route-id="@m.Id" class="text-xs bg-red-50 text-red-700 px-3 py-1 rounded-full hover:bg-red-100">Delete</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
