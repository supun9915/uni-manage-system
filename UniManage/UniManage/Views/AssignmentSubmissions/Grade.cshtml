@model UniManage.Models.AssignmentSubmissionModel
@{
    ViewData["Title"] = "Grade Submission";
}

<div class="max-w-lg">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-base font-semibold text-gray-800 mb-5">Grade Submission</h2>

        <div class="mb-5 p-4 bg-gray-50 rounded-lg text-sm space-y-2">
            <p><span class="text-gray-500">Student:</span> <strong>@Model.Student?.FirstName @Model.Student?.LastName</strong></p>
            <p><span class="text-gray-500">Assignment:</span> @Model.Assignment?.Title</p>
            <p><span class="text-gray-500">Max Marks:</span> @Model.Assignment?.MaxMarks</p>
            <p><span class="text-gray-500">Submitted:</span> @Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")</p>
            @if (!string.IsNullOrEmpty(Model.FileUrl))
            {
                <p><span class="text-gray-500">File:</span>
                    <a href="@Model.FileUrl" target="_blank" class="text-indigo-600 hover:underline">@(Model.FileName ?? "Download")</a>
                </p>
            }
        </div>

        <form asp-action="Grade" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label for="marksObtained" class="block text-sm font-medium text-gray-700 mb-1">Marks Obtained</label>
                <input type="number" name="marksObtained" value="@Model.MarksObtained" min="0" max="@Model.Assignment?.MaxMarks" required
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div class="mb-6">
                <label for="feedback" class="block text-sm font-medium text-gray-700 mb-1">Feedback</label>
                <textarea name="feedback" rows="3" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">@Model.Feedback</textarea>
            </div>
            <div class="flex gap-3">
                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors">Save Grade</button>
                <a asp-action="Index" asp-route-assignmentId="@Model.AssignmentId"
                   class="text-sm font-medium text-gray-500 hover:text-gray-700 px-5 py-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
