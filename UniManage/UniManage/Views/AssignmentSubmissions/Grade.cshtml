@model UniManage.Models.AssignmentSubmissionModel
@{
    ViewData["Title"] = "Grade Submission";
}

<div class="max-w-lg mx-auto">
    <div class="page-card">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center">
                <i class="fa-solid fa-star text-emerald-600"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Grade Submission</h2>
                <p class="text-xs text-slate-400">Evaluate and provide feedback</p>
            </div>
        </div>

        <div class="mb-5 p-4 bg-slate-50 rounded-xl text-sm space-y-2">
            <p><span class="text-slate-400"><i class="fa-solid fa-user mr-1"></i>Student:</span> <strong class="text-slate-800">@Model.Student?.FirstName @Model.Student?.LastName</strong></p>
            <p><span class="text-slate-400"><i class="fa-solid fa-clipboard-list mr-1"></i>Assignment:</span> <span class="text-slate-700">@Model.Assignment?.Title</span></p>
            <p><span class="text-slate-400"><i class="fa-solid fa-star mr-1"></i>Max Marks:</span> <span class="text-blue-700 ">@Model.Assignment?.MaxMarks</span></p>
            <p><span class="text-slate-400"><i class="fa-solid fa-clock mr-1"></i>Submitted:</span> <span class="text-slate-700">@Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")</span></p>
            @if (!string.IsNullOrEmpty(Model.FileUrl))
            {
                <p><span class="text-slate-400"><i class="fa-solid fa-file mr-1"></i>File:</span>
                    <a href="@Model.FileUrl" target="_blank" class="text-blue-700 hover:underline inline-flex items-center gap-1">
                        <i class="fa-solid fa-file-arrow-down text-xs"></i> @(Model.FileName ?? "Download")
                    </a>
                </p>
            }
        </div>

        <form asp-action="Grade" asp-route-id="@Model.Id" method="post" data-val="true">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label for="marksObtained" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5">
                    <i class="fa-solid fa-star mr-1"></i>Marks Obtained
                    <span class="normal-case font-normal text-slate-400">(Max: @Model.Assignment?.MaxMarks)</span>
                </label>
                <input type="number" name="marksObtained" value="@Model.MarksObtained" min="0" max="@Model.Assignment?.MaxMarks" required
                       class="form-input" placeholder="Enter marks" />
            </div>
            <div class="mb-6">
                <label for="feedback" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5">
                    <i class="fa-solid fa-comment mr-1"></i>Feedback
                </label>
                <textarea name="feedback" rows="3" class="form-input" placeholder="Provide constructive feedback...">@Model.Feedback</textarea>
            </div>
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="btn-primary"><i class="fa-solid fa-check"></i> Save Grade</button>
                <a asp-action="Index" asp-route-assignmentId="@Model.AssignmentId" class="btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
            </div>
        </form>
    </div>
</div>
