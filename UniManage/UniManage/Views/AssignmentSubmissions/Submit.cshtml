@{
    ViewData["Title"] = "Submit Assignment";
    var assignment = ViewBag.Assignment as UniManage.Models.AssignmentModel;
    var existing = ViewBag.Existing as UniManage.Models.AssignmentSubmissionModel;
}

<div class="max-w-lg">
    <div class="page-card">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
                <i class="fa-solid fa-paper-plane text-blue-700"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Submit Assignment</h2>
                <p class="text-xs text-slate-500">@assignment?.Title</p>
            </div>
        </div>

        @if (assignment?.DeadlineDate.HasValue == true)
        {
            var isLate = assignment.DeadlineDate < DateTime.UtcNow;
            <div class="mb-4 px-4 py-3 rounded-lg text-xs flex items-center gap-2 @(isLate ? "bg-red-50 border border-red-100 text-red-700" : "bg-blue-50 border border-blue-100 text-blue-700")">
                <i class="fa-solid @(isLate ? "fa-circle-exclamation" : "fa-clock") flex-shrink-0"></i>
                @if (isLate)
                {
                    <span>Deadline has passed: <strong>@assignment.DeadlineDate.Value.ToString("dd MMM yyyy HH:mm")</strong></span>
                }
                else
                {
                    <span>Deadline: <strong>@assignment.DeadlineDate.Value.ToString("dd MMM yyyy HH:mm")</strong></span>
                }
            </div>
        }

        @if (existing != null)
        {
            <div class="mb-4 p-3 bg-emerald-50 border border-emerald-100 rounded-lg text-sm text-emerald-700 flex items-start gap-2">
                <i class="fa-solid fa-circle-check mt-0.5 flex-shrink-0"></i>
                <span>Already submitted on <strong>@existing.SubmittedAt.ToString("dd MMM yyyy HH:mm")</strong>. You can resubmit below.</span>
            </div>
        }

        <form asp-action="Submit" asp-route-assignmentId="@assignment?.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-6">
                <label class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-upload mr-1"></i>Upload File</label>
                <input type="file" name="file" required
                       class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file: file:bg-blue-700 file:text-white hover:file:bg-blue-800 file:transition-colors" />
                <p class="text-xs text-slate-400 mt-1.5"><i class="fa-solid fa-info-circle mr-1"></i>Accepted: PDF, Word, images, ZIP, etc.</p>
            </div>
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="btn-primary">
                    <i class="fa-solid fa-paper-plane"></i> @(existing != null ? "Resubmit" : "Submit")
                </button>
                <a asp-controller="Assignments" asp-action="Details" asp-route-id="@assignment?.Id" class="btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>
