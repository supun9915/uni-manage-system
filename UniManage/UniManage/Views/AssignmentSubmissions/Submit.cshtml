@{
    ViewData["Title"] = "Submit Assignment";
    var assignment = ViewBag.Assignment as UniManage.Models.AssignmentModel;
    var existing = ViewBag.Existing as UniManage.Models.AssignmentSubmissionModel;
}

<div class="max-w-lg">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-base font-semibold text-gray-800 mb-1">Submit Assignment</h2>
        <p class="text-sm text-gray-500 mb-5">@assignment?.Title</p>

        @if (assignment?.DeadlineDate.HasValue == true)
        {
            var isLate = assignment.DeadlineDate < DateTime.UtcNow;
            <div class="mb-4 px-4 py-3 @(isLate ? "bg-red-50 text-red-700" : "bg-blue-50 text-blue-700") rounded-lg text-xs">
                @if (isLate)
                {
                    <span>?? Deadline has passed: @assignment.DeadlineDate.Value.ToString("dd MMM yyyy HH:mm")</span>
                }
                else
                {
                    <span>?? Deadline: @assignment.DeadlineDate.Value.ToString("dd MMM yyyy HH:mm")</span>
                }
            </div>
        }

        @if (existing != null)
        {
            <div class="mb-4 p-3 bg-green-50 rounded-lg text-sm text-green-700">
                ? You already submitted this assignment on @existing.SubmittedAt.ToString("dd MMM yyyy HH:mm"). You can resubmit below.
            </div>
        }

        <form asp-action="Submit" asp-route-assignmentId="@assignment?.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-1">Upload File</label>
                <input type="file" name="file" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" />
                <p class="text-xs text-gray-400 mt-1">Accepted: PDF, Word, images, ZIP, etc.</p>
            </div>
            <div class="flex gap-3">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors">
                    @(existing != null ? "Resubmit" : "Submit")
                </button>
                <a asp-controller="Assignments" asp-action="Details" asp-route-id="@assignment?.Id"
                   class="text-sm font-medium text-gray-500 hover:text-gray-700 px-5 py-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
