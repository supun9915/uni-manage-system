@model IEnumerable<UniManage.Models.AssignmentSubmissionModel>
@{
    ViewData["Title"] = "Submissions";
    var assignment = ViewBag.Assignment as UniManage.Models.AssignmentModel;
}

<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <div class="mb-5">
        <h2 class="text-base font-semibold text-gray-800">Submissions for: @assignment?.Title</h2>
        <p class="text-sm text-gray-400">@assignment?.Module?.Course?.Title — @assignment?.Module?.Title</p>
    </div>
    @if (!Model.Any())
    {
        <p class="text-sm text-gray-400">No submissions yet.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-xs text-gray-500 border-b">
                        <th class="pb-2 font-medium">Student</th>
                        <th class="pb-2 font-medium">File</th>
                        <th class="pb-2 font-medium">Submitted</th>
                        <th class="pb-2 font-medium">Status</th>
                        <th class="pb-2 font-medium">Grade</th>
                        <th class="pb-2 font-medium">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="py-2.5 font-medium">@s.Student?.FirstName @s.Student?.LastName</td>
                            <td class="py-2.5">
                                @if (!string.IsNullOrEmpty(s.FileUrl))
                                {
                                    <a href="@s.FileUrl" target="_blank" class="text-indigo-600 hover:underline text-xs">@(s.FileName ?? "Download")</a>
                                }
                                else
                                {
                                    <span class="text-gray-400 text-xs">—</span>
                                }
                            </td>
                            <td class="py-2.5 text-gray-400">@s.SubmittedAt.ToString("dd MMM HH:mm")</td>
                            <td class="py-2.5">
                                @{
                                    var cls = s.Status switch { "graded" => "bg-green-50 text-green-700", "late" => "bg-red-50 text-red-700", _ => "bg-orange-50 text-orange-700" };
                                }
                                <span class="text-xs @cls px-2 py-0.5 rounded-full capitalize">@s.Status</span>
                            </td>
                            <td class="py-2.5">
                                @if (s.MarksObtained.HasValue)
                                {
                                    <strong class="text-green-600">@s.MarksObtained</strong>
                                }
                                else
                                {
                                    <span class="text-gray-400">—</span>
                                }
                            </td>
                            <td class="py-2.5">
                                <a asp-action="Grade" asp-route-id="@s.Id"
                                   class="text-xs bg-indigo-50 text-indigo-600 px-3 py-1 rounded-full hover:bg-indigo-100">
                                    @(s.Status == "graded" ? "Re-grade" : "Grade")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
