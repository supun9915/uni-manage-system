@model IEnumerable<UniManage.Models.AssignmentSubmissionModel>
@{
    ViewData["Title"] = "Submissions";
    var assignment = ViewBag.Assignment as UniManage.Models.AssignmentModel;
    var assignments = ViewBag.Assignments as List<UniManage.Models.AssignmentModel> ?? new();
    bool showAll = assignment == null;
}

<div class="page-card">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
        <div>
            <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                <i class="fa-solid fa-inbox text-blue-700"></i>
                @if (showAll)
                {
                    <span>All Submissions</span>
                    <span class="text-xs bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full font-medium">@Model.Count()</span>
                }
                else
                {
                    <span>Submissions</span>
                }
            </h2>
            @if (!showAll)
            {
                <p class="text-sm text-slate-500 mt-1">
                    <i class="fa-solid fa-clipboard-list mr-1 text-blue-600"></i>
                    <strong>@assignment!.Title</strong> &mdash; @assignment.Module?.Course?.Title &mdash; @assignment.Module?.Title
                </p>
            }
        </div>

        <!-- Assignment filter dropdown -->
        <form method="get" asp-action="Index" class="flex items-center gap-2">
            <select name="assignmentId" onchange="this.form.submit()"
                    class="text-xs border border-slate-200 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-1 focus:ring-blue-300 text-slate-600 bg-white min-w-[200px]">
                <option value="">— All Assignments —</option>
                @foreach (var a in assignments)
                {
                    if (assignment?.Id == a.Id)
                    {
                        <option value="@a.Id" selected>@a.Module?.Course?.Title – @a.Title</option>
                    }
                    else
                    {
                        <option value="@a.Id">@a.Module?.Course?.Title – @a.Title</option>
                    }
                }
            </select>
        </form>
    </div>

    <!-- Stats bar (when showing all) -->
    @if (showAll && Model.Any())
    {
        <div class="grid grid-cols-3 gap-3 mb-5">
            <div class="bg-amber-50 rounded-xl px-4 py-3 text-center">
                <p class="text-xl font-bold text-amber-600">@Model.Count(s => s.Status == "submitted")</p>
                <p class="text-xs text-amber-600 mt-0.5">Pending</p>
            </div>
            <div class="bg-red-50 rounded-xl px-4 py-3 text-center">
                <p class="text-xl font-bold text-red-600">@Model.Count(s => s.Status == "late")</p>
                <p class="text-xs text-red-600 mt-0.5">Late</p>
            </div>
            <div class="bg-emerald-50 rounded-xl px-4 py-3 text-center">
                <p class="text-xl font-bold text-emerald-600">@Model.Count(s => s.Status == "graded")</p>
                <p class="text-xs text-emerald-600 mt-0.5">Graded</p>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="flex flex-col items-center py-12 text-slate-400">
            <i class="fa-solid fa-inbox text-4xl mb-3 opacity-30"></i>
            <p class="text-sm">No submissions yet.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="table-header">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-user mr-1"></i>Student</th>
                        @if (showAll)
                        {
                            <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-clipboard-list mr-1"></i>Assignment</th>
                        }
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-file mr-1"></i>File</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-clock mr-1"></i>Submitted</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-circle-dot mr-1"></i>Status</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-star mr-1"></i>Grade</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var s in Model)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 font-medium text-slate-800">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-blue-700 flex items-center justify-center text-white text-xs flex-shrink-0">
                                        @(s.Student?.FirstName?[0])
                                    </div>
                                    @s.Student?.FirstName @s.Student?.LastName
                                </div>
                            </td>
                            @if (showAll)
                            {
                                <td class="px-4 py-3">
                                    <p class="text-xs font-medium text-slate-700">@s.Assignment?.Title</p>
                                    <p class="text-xs text-slate-400">@s.Assignment?.Module?.Course?.Title</p>
                                </td>
                            }
                            <td class="px-4 py-3">
                                @if (s.FileData != null)
                                {
                                    <a asp-action="Download" asp-route-id="@s.Id"
                                       class="inline-flex items-center gap-1 text-xs text-blue-700 hover:underline">
                                        <i class="fa-solid fa-file-arrow-down"></i>@(s.FileName ?? "Download")
                                    </a>
                                }
                                else
                                {
                                    <span class="text-slate-400 text-xs">&mdash;</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-slate-400">@s.SubmittedAt.ToString("dd MMM HH:mm")</td>
                            <td class="px-4 py-3">
                                @{
                                    var cls = s.Status switch { "graded" => "bg-emerald-50 text-emerald-700", "late" => "bg-red-50 text-red-700", _ => "bg-amber-50 text-amber-700" };
                                    var ico = s.Status switch { "graded" => "fa-circle-check", "late" => "fa-clock", _ => "fa-hourglass-half" };
                                }
                                <span class="inline-flex items-center gap-1 text-xs @cls px-2.5 py-0.5 rounded-full font-medium capitalize">
                                    <i class="fa-solid @ico text-xs"></i>@s.Status
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                @if (s.MarksObtained.HasValue)
                                {
                                    <span class="inline-flex items-center gap-1 text-sm text-emerald-600">
                                        <i class="fa-solid fa-star text-xs"></i>@s.MarksObtained
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-400">&mdash;</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <a asp-action="Grade" asp-route-id="@s.Id"
                                   class="inline-flex items-center gap-1 text-xs bg-blue-50 text-blue-700 px-3 py-1 rounded-full hover:bg-blue-100 transition-colors">
                                    <i class="fa-solid fa-star text-xs"></i> @(s.Status == "graded" ? "Re-grade" : "Grade")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
