@model IEnumerable<UniManage.Models.AssignmentSubmissionModel>
@{
    ViewData["Title"] = "Submissions";
    var assignment = ViewBag.Assignment as UniManage.Models.AssignmentModel;
}

<div class="page-card">
    <div class="mb-5">
        <h2 class="text-sm text-slate-700 flex items-center gap-2">
            <i class="fa-solid fa-inbox text-blue-700"></i> Submissions
        </h2>
        @if (assignment != null)
        {
            <p class="text-sm text-slate-500 mt-1"><i class="fa-solid fa-clipboard-list mr-1 text-blue-600"></i><strong>@assignment.Title</strong> &mdash; @assignment.Module?.Course?.Title &mdash; @assignment.Module?.Title</p>
        }
    </div>
    @if (!Model.Any())
    {
        <div class="flex flex-col items-center py-12 text-slate-400">
            <i class="fa-solid fa-inbox text-4xl mb-3 opacity-30"></i>
            <p class="text-sm">No submissions yet.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="table-header">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-user mr-1"></i>Student</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-file mr-1"></i>File</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-clock mr-1"></i>Submitted</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-circle-dot mr-1"></i>Status</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-star mr-1"></i>Grade</th>
                        <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var s in Model)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 font-medium text-slate-800">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-blue-700 flex items-center justify-center text-white text-xs flex-shrink-0">@(s.Student?.FirstName?[0])</div>
                                    @s.Student?.FirstName @s.Student?.LastName
                                </div>
                            </td>
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrEmpty(s.FileUrl))
                                {
                                    <a href="@s.FileUrl" target="_blank" class="inline-flex items-center gap-1 text-xs text-blue-700 hover:underline"><i class="fa-solid fa-file-arrow-down"></i>@(s.FileName ?? "Download")</a>
                                }
                                else
                                {
                                    <span class="text-slate-400 text-xs">&mdash;</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-slate-400">@s.SubmittedAt.ToString("dd MMM HH:mm")</td>
                            <td class="px-4 py-3">
                                @{
                                    var cls = s.Status switch { "graded" => "bg-emerald-50 text-emerald-700", "late" => "bg-red-50 text-red-700", _ => "bg-amber-50 text-amber-700" };
                                    var ico = s.Status switch { "graded" => "fa-circle-check", "late" => "fa-clock", _ => "fa-hourglass-half" };
                                }
                                <span class="inline-flex items-center gap-1 text-xs @cls px-2.5 py-0.5 rounded-full font-medium capitalize"><i class="fa-solid @ico text-xs"></i>@s.Status</span>
                            </td>
                            <td class="px-4 py-3">
                                @if (s.MarksObtained.HasValue)
                                {
                                    <span class="inline-flex items-center gap-1 text-sm text-emerald-600"><i class="fa-solid fa-star text-xs"></i>@s.MarksObtained</span>
                                }
                                else
                                {
                                    <span class="text-slate-400">&mdash;</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <a asp-action="Grade" asp-route-id="@s.Id"
                                   class="inline-flex items-center gap-1 text-xs bg-blue-50 text-blue-700 px-3 py-1 rounded-full hover:bg-blue-100 transition-colors">
                                    <i class="fa-solid fa-star text-xs"></i> @(s.Status == "graded" ? "Re-grade" : "Grade")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
</div>
