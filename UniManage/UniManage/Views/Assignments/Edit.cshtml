@model UniManage.Models.AssignmentModel
@{
    ViewData["Title"] = "Edit Assignment";
}
<div class="max-w-xl mx-auto">
    <div class="page-card">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center">
                <i class="fa-solid fa-clipboard-list text-amber-600"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Edit Assignment</h2>
                <p class="text-xs text-slate-400">Update assignment details</p>
            </div>
        </div>
        <form asp-action="Edit" method="post" data-val="true">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-4">
                <label asp-for="ModuleId" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-layer-group mr-1"></i>Module</label>
                <select asp-for="ModuleId" asp-items="ViewBag.Modules" class="form-input"></select>
            </div>
            <div class="mb-4">
                <label asp-for="Title" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-heading mr-1"></i>Title</label>
                <input asp-for="Title" class="form-input" required />
            </div>
            <div class="mb-4">
                <label asp-for="Description" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-align-left mr-1"></i>Description</label>
                <textarea asp-for="Description" rows="2" class="form-input"></textarea>
            </div>
            <div class="mb-4">
                <label asp-for="Instructions" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-list-check mr-1"></i>Instructions</label>
                <textarea asp-for="Instructions" rows="3" class="form-input"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="MaxMarks" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-star mr-1"></i>Max Marks</label>
                    <input asp-for="MaxMarks" type="number" min="1" class="form-input" />
                </div>
                <div>
                    <label asp-for="DeadlineDate" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-clock mr-1"></i>Deadline</label>
                    <input asp-for="DeadlineDate" type="datetime-local" class="form-input" />
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="ReleaseDate" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-calendar-check mr-1"></i>Release Date</label>
                <input asp-for="ReleaseDate" type="datetime-local" class="form-input" />
            </div>
            <div class="mb-6 flex items-center gap-2.5 p-3 bg-slate-50 rounded-lg">
                <input asp-for="AllowLateSubmit" type="checkbox" class="w-4 h-4 rounded accent-blue-700" />
                <label asp-for="AllowLateSubmit" class="text-sm text-slate-600 font-medium cursor-pointer"><i class="fa-solid fa-clock-rotate-left mr-1 text-amber-500"></i>Allow Late Submission</label>
            </div>
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
                <a asp-action="Index" class="btn-secondary"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>
