@model UniManage.Models.AssignmentModel
@{
    ViewData["Title"] = "Edit Assignment";
}
<div class="max-w-xl">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-base font-semibold text-gray-800 mb-5">Edit Assignment</h2>
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-4">
                <label asp-for="ModuleId" class="block text-sm font-medium text-gray-700 mb-1">Module</label>
                <select asp-for="ModuleId" asp-items="ViewBag.Modules" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"></select>
            </div>
            <div class="mb-4">
                <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Title" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div class="mb-4">
                <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <textarea asp-for="Description" rows="2" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
            </div>
            <div class="mb-4">
                <label asp-for="Instructions" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <textarea asp-for="Instructions" rows="3" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="MaxMarks" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="MaxMarks" type="number" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <div>
                    <label asp-for="DeadlineDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="DeadlineDate" type="datetime-local" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="ReleaseDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="ReleaseDate" type="datetime-local" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <div class="mb-6 flex items-center gap-2">
                <input asp-for="AllowLateSubmit" type="checkbox" class="w-4 h-4 text-indigo-600 rounded" />
                <label asp-for="AllowLateSubmit" class="text-sm text-gray-700">Allow Late Submission</label>
            </div>
            <div class="flex gap-3">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors">Save</button>
                <a asp-action="Index" class="text-sm font-medium text-gray-500 hover:text-gray-700 px-5 py-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
