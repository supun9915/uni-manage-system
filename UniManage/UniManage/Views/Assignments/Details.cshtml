@model UniManage.Models.AssignmentModel
@{
    ViewData["Title"] = Model.Title;
    var role = ViewBag.CurrentUserRole as string;
    var mySubmission = ViewBag.MySubmission as UniManage.Models.AssignmentSubmissionModel;
}

<div class="space-y-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-xl text-gray-800">@Model.Title</h2>
        <p class="text-sm text-gray-400 mt-1">@Model.Module?.Course?.Title � @Model.Module?.Title</p>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-sm text-gray-600 mt-3">@Model.Description</p>
        }
        @if (!string.IsNullOrEmpty(Model.Instructions))
        {
            <div class="mt-4 p-4 bg-blue-50 rounded-lg">
                <p class="text-xs text-blue-800 mb-1">Instructions</p>
                <p class="text-sm text-blue-700">@Model.Instructions</p>
            </div>
        }
        <div class="flex gap-6 mt-4 text-sm">
            <span class="text-gray-500">Max Marks: <strong class="text-gray-800">@Model.MaxMarks</strong></span>
            @if (Model.DeadlineDate.HasValue)
            {
                <span class="text-gray-500">Deadline: <strong class="text-gray-800">@Model.DeadlineDate.Value.ToString("dd MMM yyyy HH:mm")</strong></span>
            }
        </div>
    </div>

    @if (role == "student")
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <h3 class="text-base text-gray-800 mb-3">My Submission</h3>
            @if (mySubmission != null)
            {
                <div class="space-y-2 text-sm">
                    <p><span class="text-gray-500">Status:</span>
                        <span class="@(mySubmission.Status == "graded" ? "text-green-600" : mySubmission.Status == "late" ? "text-red-500" : "text-orange-500") font-medium capitalize">@mySubmission.Status</span>
                    </p>
                    @if (!string.IsNullOrEmpty(mySubmission.FileName))
                    {
                        <p><span class="text-gray-500">File:</span> <a href="@mySubmission.FileUrl" target="_blank" class="text-indigo-600 hover:underline">@mySubmission.FileName</a></p>
                    }
                    <p><span class="text-gray-500">Submitted:</span> @mySubmission.SubmittedAt.ToString("dd MMM yyyy HH:mm")</p>
                    @if (mySubmission.MarksObtained.HasValue)
                    {
                        <p><span class="text-gray-500">Grade:</span> <strong class="text-green-600">@mySubmission.MarksObtained / @Model.MaxMarks</strong></p>
                    }
                    @if (!string.IsNullOrEmpty(mySubmission.Feedback))
                    {
                        <p><span class="text-gray-500">Feedback:</span> @mySubmission.Feedback</p>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-gray-400 mb-3">You have not submitted this assignment yet.</p>
            }
            <a asp-controller="AssignmentSubmissions" asp-action="Submit" asp-route-assignmentId="@Model.Id"
               class="inline-block mt-3 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors">
                @(mySubmission != null ? "Resubmit" : "Submit Assignment")
            </a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base text-gray-800">Submissions (@Model.Submissions.Count)</h3>
                <a asp-controller="AssignmentSubmissions" asp-action="Index" asp-route-assignmentId="@Model.Id"
                   class="text-xs bg-purple-50 text-purple-600 px-3 py-1.5 rounded-lg hover:bg-purple-100">View All</a>
            </div>
        </div>
    }
</div>
