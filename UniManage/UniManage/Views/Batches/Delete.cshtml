@model UniManage.Models.BatchModel
@{
    ViewData["Title"] = "Delete Batch";
}
<div class="max-w-lg">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-base text-gray-800 mb-2">Delete Batch</h2>
        <p class="text-sm text-gray-500 mb-5">Are you sure you want to delete batch <strong>@Model.Name</strong> from <strong>@Model.Course?.Title</strong>?</p>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="flex gap-3">
                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors">Delete</button>
                <a asp-action="Index" class="text-sm font-medium text-gray-500 hover:text-gray-700 px-5 py-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
