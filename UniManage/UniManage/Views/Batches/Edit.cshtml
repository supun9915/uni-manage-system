@model UniManage.Models.BatchModel
@{
    ViewData["Title"] = "Edit Batch";
}
<div class="max-w-lg mx-auto">
    <div class="page-card">
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center">
                <i class="fa-solid fa-people-group text-amber-600"></i>
            </div>
            <div>
                <h2 class="text-base text-slate-800">Edit Batch</h2>
                <p class="text-xs text-slate-400">Update batch details</p>
            </div>
        </div>
        <form asp-action="Edit" method="post" data-val="true">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-4">
                <label asp-for="Name" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-people-group mr-1"></i>Batch Name</label>
                <input asp-for="Name" class="form-input" />
            </div>
            <div class="mb-4">
                <label asp-for="CourseId" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-book-open mr-1"></i>Course</label>
                <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-input"></select>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label asp-for="StartDate" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-calendar-plus mr-1"></i>Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-input" />
                </div>
                <div>
                    <label asp-for="EndDate" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-calendar-xmark mr-1"></i>End Date</label>
                    <input asp-for="EndDate" type="date" class="form-input" />
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="MaxStudents" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-users mr-1"></i>Max Students</label>
                <input asp-for="MaxStudents" type="number" class="form-input" />
            </div>
            <div class="mb-6">
                <label asp-for="Status" class="block text-xs text-slate-500 uppercase tracking-wide mb-1.5"><i class="fa-solid fa-circle-dot mr-1"></i>Status</label>
                <select asp-for="Status" class="form-input">
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                    <option value="completed">Completed</option>
                </select>
            </div>
            <div class="flex gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
                <a asp-action="Index" class="btn-secondary"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>
