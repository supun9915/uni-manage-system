@{
    ViewData["Title"] = "Lecturer Dashboard";
    var courses            = ViewBag.Courses            as List<UniManage.Models.CourseModel>                    ?? new();
    var recentSubmissions  = ViewBag.RecentSubmissions  as List<UniManage.Models.AssignmentSubmissionModel>      ?? new();
    var assignments        = ViewBag.Assignments        as List<UniManage.Models.AssignmentModel>                ?? new();
    int pendingGrading     = ViewBag.PendingGrading     ?? 0;

    var gradedCount    = recentSubmissions.Count(s => s.Status == "graded");
    var submittedCount = recentSubmissions.Count(s => s.Status == "submitted" || s.Status == "late");
    var totalSubs      = recentSubmissions.Count;
}

<div class="space-y-6">

    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-gauge-high text-blue-700"></i> Lecturer Dashboard
            </h1>
            <p class="text-xs text-slate-400 mt-0.5">Welcome back, <span class="font-semibold text-slate-600">@User.Identity?.Name</span></p>
        </div>
        <span class="text-xs text-slate-400"><i class="fa-regular fa-clock mr-1"></i>@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
    </div>

    <!-- Primary Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-5 shadow-sm border border-blue-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">My Courses</p>
                <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center">
                    <i class="fa-solid fa-book-open text-blue-700 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-blue-700">@courses.Count</p>
            <a asp-controller="Courses" asp-action="Index" class="text-xs text-blue-600 hover:underline mt-1 inline-block">Manage &rarr;</a>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-amber-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Assignments</p>
                <div class="w-9 h-9 rounded-lg bg-amber-50 flex items-center justify-center">
                    <i class="fa-solid fa-clipboard-list text-amber-600 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-amber-600">@assignments.Count</p>
            <a asp-controller="Assignments" asp-action="Index" class="text-xs text-amber-600 hover:underline mt-1 inline-block">View all &rarr;</a>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-red-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Pending Grading</p>
                <div class="w-9 h-9 rounded-lg bg-red-50 flex items-center justify-center">
                    <i class="fa-solid fa-hourglass-half text-red-500 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-red-500">@pendingGrading</p>
            <a asp-controller="AssignmentSubmissions" asp-action="Index" asp-route-assignmentId="0" class="text-xs text-red-500 hover:underline mt-1 inline-block">Grade now &rarr;</a>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-emerald-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Graded</p>
                <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center">
                    <i class="fa-solid fa-circle-check text-emerald-600 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-emerald-600">@gradedCount <span class="text-base font-normal text-slate-400">/ @totalSubs</span></p>
            <span class="text-xs text-slate-400 mt-1 inline-block">Recent submissions</span>
        </div>
    </div>

    <!-- Chart + Courses Row -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Grading Progress Chart -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5 flex flex-col">
            <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2 mb-4">
                <i class="fa-solid fa-chart-bar text-blue-600"></i> Grading Overview
            </h2>
            <div class="flex-1 h-44">
                <canvas id="gradingChart"></canvas>
            </div>
        </div>

        <!-- My Courses -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-slate-100 p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                    <i class="fa-solid fa-book-open text-blue-700"></i> My Courses
                </h2>
                <a asp-controller="Courses" asp-action="Index" class="text-xs text-blue-700 hover:underline font-medium">Manage &rarr;</a>
            </div>
            @if (!courses.Any())
            {
                <div class="flex flex-col items-center py-8 text-slate-300">
                    <i class="fa-solid fa-book-open text-3xl mb-2 opacity-30"></i>
                    <p class="text-sm font-medium text-slate-400">No courses assigned yet.</p>
                </div>
            }
            else
            {
                <ul class="space-y-2">
                    @foreach (var c in courses)
                    {
                        var initial = c.Code?.Length > 0 ? c.Code.Substring(0, 1) : "?";
                        <li class="flex items-center gap-3 p-3 rounded-xl hover:bg-blue-50 transition-colors group">
                            <div class="w-10 h-10 rounded-xl bg-blue-700 flex items-center justify-center text-white text-sm font-bold flex-shrink-0 shadow-sm">
                                @initial
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-slate-800 truncate">@c.Title</p>
                                <p class="text-xs text-slate-400 mt-0.5">
                                    <i class="fa-solid fa-building mr-1"></i>@c.Department?.Name
                                    <span class="text-slate-300 mx-1">&middot;</span>
                                    <span class="font-mono">@c.Code</span>
                                </p>
                            </div>
                            <div class="flex gap-2 flex-shrink-0">
                                <a asp-controller="Modules" asp-action="Index" asp-route-courseId="@c.Id"
                                   class="inline-flex items-center gap-1 text-xs bg-blue-50 text-blue-700 px-3 py-1 rounded-full hover:bg-blue-100 transition-colors">
                                    <i class="fa-solid fa-layer-group text-xs"></i> Modules
                                </a>
                                <a asp-controller="Assignments" asp-action="Index" asp-route-moduleId=""
                                   class="inline-flex items-center gap-1 text-xs bg-amber-50 text-amber-700 px-3 py-1 rounded-full hover:bg-amber-100 transition-colors">
                                    <i class="fa-solid fa-clipboard-list text-xs"></i> Assign.
                                </a>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <!-- Recent Submissions -->
    <div class="page-card">
        <div class="flex items-center justify-between mb-5">
            <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-blue-50 flex items-center justify-center">
                    <i class="fa-solid fa-inbox text-blue-700 text-xs"></i>
                </span>
                Recent Submissions
            </h2>
            @if (pendingGrading > 0)
            {
                <span class="inline-flex items-center gap-1 text-xs bg-red-50 text-red-600 font-semibold px-2.5 py-0.5 rounded-full">
                    <i class="fa-solid fa-hourglass-half text-xs"></i> @pendingGrading to grade
                </span>
            }
        </div>
        @if (!recentSubmissions.Any())
        {
            <div class="flex flex-col items-center py-8 text-slate-300">
                <i class="fa-solid fa-inbox text-3xl mb-2 opacity-30"></i>
                <p class="text-sm font-medium text-slate-400">No submissions yet.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="table-header">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-user mr-1"></i>Student</th>
                            <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-file-lines mr-1"></i>Assignment</th>
                            <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-regular fa-clock mr-1"></i>Submitted</th>
                            <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider"><i class="fa-solid fa-circle-dot mr-1"></i>Status</th>
                            <th class="px-4 py-3 text-left text-xs text-white uppercase tracking-wider">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var s in recentSubmissions)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-4 py-3 text-slate-800">
                                    <div class="flex items-center gap-2">
                                        <div class="w-7 h-7 rounded-full bg-blue-700 flex items-center justify-center text-white text-xs flex-shrink-0">
                                            @(s.Student?.FirstName?.Length > 0 ? s.Student.FirstName[0].ToString() : "?")
                                        </div>
                                        @s.Student?.FirstName @s.Student?.LastName
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-slate-600 truncate max-w-[160px]">@s.Assignment?.Title</td>
                                <td class="px-4 py-3 text-slate-400">@s.SubmittedAt.ToString("dd MMM HH:mm")</td>
                                <td class="px-4 py-3">
                                    @if (s.Status == "graded")
                                    {
                                        <span class="inline-flex items-center gap-1 text-xs bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-full">
                                            <i class="fa-solid fa-check text-xs"></i> Graded
                                        </span>
                                    }
                                    else if (s.Status == "late")
                                    {
                                        <span class="inline-flex items-center gap-1 text-xs bg-amber-50 text-amber-700 px-2.5 py-0.5 rounded-full">
                                            <i class="fa-solid fa-clock text-xs"></i> Late
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 text-xs bg-blue-50 text-blue-700 px-2.5 py-0.5 rounded-full">
                                            <i class="fa-solid fa-hourglass-half text-xs"></i> Submitted
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    @if (s.Status == "submitted" || s.Status == "late")
                                    {
                                        <a asp-controller="AssignmentSubmissions" asp-action="Grade" asp-route-id="@s.Id"
                                           class="inline-flex items-center gap-1 text-xs bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full hover:bg-emerald-100 transition-colors">
                                            <i class="fa-solid fa-star text-xs"></i> Grade
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-300">&mdash;</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Quick Actions -->
    <div class="page-card">
        <h2 class="text-sm text-slate-700 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-bolt text-blue-700"></i> Quick Actions
        </h2>
        <div class="flex flex-wrap gap-3">
            <a asp-controller="Courses" asp-action="Index"
               class="inline-flex items-center gap-2 bg-blue-700 hover:bg-blue-800 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-book-open"></i> My Courses
            </a>
            <a asp-controller="Assignments" asp-action="Index"
               class="inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-clipboard-list"></i> Assignments
            </a>
            <a asp-controller="AssignmentSubmissions" asp-action="Index" asp-route-assignmentId="0"
               class="inline-flex items-center gap-2 bg-red-500 hover:bg-red-600 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-star"></i> Grade Submissions
            </a>
            <a asp-controller="Announcements" asp-action="Create"
               class="inline-flex items-center gap-2 bg-slate-600 hover:bg-slate-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-bullhorn"></i> New Announcement
            </a>
        </div>
    </div>

</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    new Chart(document.getElementById('gradingChart'), {
        type: 'bar',
        data: {
            labels: ['Pending', 'Graded'],
            datasets: [{
                label: 'Submissions',
                data: [@submittedCount, @gradedCount],
                backgroundColor: ['rgba(239,68,68,0.15)', 'rgba(16,185,129,0.15)'],
                borderColor: ['#ef4444', '#10b981'],
                borderWidth: 2,
                borderRadius: 6
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 10 }, color: '#94a3b8', stepSize: 1 } },
                x: { grid: { display: false }, ticks: { font: { size: 11 }, color: '#64748b' } }
            }
        }
    });
</script>
}
