@{
    ViewData["Title"] = "Student Dashboard";
    var enrollments   = ViewBag.Enrollments   as List<UniManage.Models.EnrollmentModel>           ?? new();
    var assignments   = ViewBag.Assignments   as List<UniManage.Models.AssignmentModel>           ?? new();
    var submissions   = ViewBag.Submissions   as List<UniManage.Models.AssignmentSubmissionModel> ?? new();
    var announcements = ViewBag.Announcements as List<UniManage.Models.AnnouncementModel>         ?? new();

    var upcomingCount  = assignments.Count(a => a.DeadlineDate > DateTime.UtcNow);
    var overdueCount   = assignments.Count(a => a.DeadlineDate.HasValue && a.DeadlineDate < DateTime.UtcNow && !submissions.Any(s => s.AssignmentId == a.Id));
    var submittedCount = submissions.Count;
    var pendingCount   = assignments.Count(a => !submissions.Any(s => s.AssignmentId == a.Id) && (!a.DeadlineDate.HasValue || a.DeadlineDate >= DateTime.UtcNow));
    var submissionRate = assignments.Count > 0 ? (int)Math.Round((double)submittedCount / assignments.Count * 100) : 0;
}

<div class="space-y-6">

    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-gauge-high text-blue-700"></i> Student Dashboard
            </h1>
            <p class="text-xs text-slate-400 mt-0.5">Welcome back, <span class="font-semibold text-slate-600">@User.Identity?.Name</span></p>
        </div>
        <span class="text-xs text-slate-400"><i class="fa-regular fa-clock mr-1"></i>@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
    </div>

    <!-- Primary Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-5 shadow-sm border border-blue-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Enrolled Courses</p>
                <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center">
                    <i class="fa-solid fa-book-open text-blue-700 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-blue-700">@enrollments.Count</p>
            <a asp-controller="Courses" asp-action="Index" class="text-xs text-blue-600 hover:underline mt-1 inline-block">View courses &rarr;</a>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-amber-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Upcoming</p>
                <div class="w-9 h-9 rounded-lg bg-amber-50 flex items-center justify-center">
                    <i class="fa-solid fa-clipboard-list text-amber-600 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-amber-600">@upcomingCount</p>
            <a asp-controller="Assignments" asp-action="Index" class="text-xs text-amber-600 hover:underline mt-1 inline-block">View assignments &rarr;</a>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-emerald-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Submitted</p>
                <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center">
                    <i class="fa-solid fa-paper-plane text-emerald-600 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-emerald-600">@submittedCount <span class="text-base font-normal text-slate-400">/ @assignments.Count</span></p>
            <a asp-controller="AssignmentSubmissions" asp-action="MyGrades" class="text-xs text-emerald-600 hover:underline mt-1 inline-block">My grades &rarr;</a>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-red-50 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs text-slate-400 uppercase tracking-wide">Overdue</p>
                <div class="w-9 h-9 rounded-lg bg-red-50 flex items-center justify-center">
                    <i class="fa-solid fa-triangle-exclamation text-red-500 text-sm"></i>
                </div>
            </div>
            <p class="text-3xl font-bold text-red-500">@overdueCount</p>
            @if (overdueCount > 0)
            {
                <span class="inline-flex items-center gap-1 text-xs bg-red-50 text-red-600 px-2 py-0.5 rounded-full mt-1">Needs attention</span>
            }
            else
            {
                <span class="inline-flex items-center gap-1 text-xs bg-emerald-50 text-emerald-600 px-2 py-0.5 rounded-full mt-1"><i class="fa-solid fa-check text-xs"></i> All on track</span>
            }
        </div>
    </div>

    <!-- Chart + Course List Row -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Assignment Status Doughnut -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5 flex flex-col">
            <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2 mb-4">
                <i class="fa-solid fa-chart-pie text-emerald-600"></i> Assignment Status
            </h2>
            <div class="flex-1 flex items-center justify-center h-44">
                <canvas id="submissionStatusChart"></canvas>
            </div>
            <div id="submissionLegend" class="flex flex-wrap gap-2 mt-3 justify-center text-xs"></div>
        </div>

        <!-- My Courses -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-slate-100 p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                    <i class="fa-solid fa-book-open text-blue-700"></i> My Courses
                </h2>
                <a asp-controller="Courses" asp-action="Index" class="text-xs text-blue-700 hover:underline font-medium inline-flex items-center gap-1">View all <i class="fa-solid fa-arrow-right text-xs"></i></a>
            </div>
            @if (!enrollments.Any())
            {
                <div class="flex flex-col items-center py-10 text-slate-300">
                    <i class="fa-solid fa-book-open text-4xl mb-3"></i>
                    <p class="text-sm font-medium text-slate-400">No courses yet</p>
                    <p class="text-xs text-slate-300 mt-1">You are not enrolled in any courses.</p>
                </div>
            }
            else
            {
                <ul class="space-y-2">
                    @foreach (var e in enrollments)
                    {
                        var courseInitial = e.Course?.Code?.Length > 0 ? e.Course.Code.Substring(0, 1) : "?";
                        <li class="flex items-center gap-3 p-3 rounded-xl hover:bg-blue-50 transition-colors group cursor-default">
                            <div class="w-10 h-10 rounded-xl bg-blue-700 flex items-center justify-center text-white text-sm font-bold flex-shrink-0 shadow-sm">
                                @courseInitial
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-slate-800 truncate">@e.Course?.Title</p>
                                <div class="flex items-center gap-2 mt-0.5">
                                    <span class="text-xs text-slate-400 font-mono">@e.Course?.Code</span>
                                    <span class="text-slate-300">&middot;</span>
                                    <span class="text-xs text-slate-400"><i class="fa-solid fa-users mr-1 text-slate-300"></i>@e.Batch?.Name</span>
                                </div>
                            </div>
                            <i class="fa-solid fa-chevron-right text-xs text-slate-200 group-hover:text-blue-400 transition-colors flex-shrink-0"></i>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <!-- Assignments & Announcements Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- Assignments -->
        <div class="page-card">
            <div class="flex items-center justify-between mb-5">
                <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-amber-50 flex items-center justify-center">
                        <i class="fa-solid fa-clipboard-list text-amber-600 text-xs"></i>
                    </span>
                    Assignments
                </h2>
                <a asp-controller="Assignments" asp-action="Index" class="text-xs text-blue-700 hover:underline font-medium inline-flex items-center gap-1">View all <i class="fa-solid fa-arrow-right text-xs"></i></a>
            </div>
            @if (!assignments.Any())
            {
                <div class="flex flex-col items-center py-10 text-slate-300">
                    <i class="fa-solid fa-clipboard-list text-4xl mb-3"></i>
                    <p class="text-sm font-medium text-slate-400">No assignments</p>
                    <p class="text-xs text-slate-300 mt-1">Check back later for new assignments.</p>
                </div>
            }
            else
            {
                <ul class="space-y-2">
                    @foreach (var a in assignments)
                    {
                        var isOverdue = a.DeadlineDate.HasValue && a.DeadlineDate < DateTime.UtcNow;
                        var submitted = submissions.Any(s => s.AssignmentId == a.Id);
                        var isDueSoon = !submitted && !isOverdue && a.DeadlineDate.HasValue && (a.DeadlineDate.Value - DateTime.UtcNow).TotalDays <= 2;
                        <li class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors @(isOverdue && !submitted ? "border-l-2 border-red-400" : submitted ? "border-l-2 border-emerald-400" : isDueSoon ? "border-l-2 border-amber-400" : "border-l-2 border-transparent") pl-3">
                            <div class="flex-1 min-w-0 pr-2">
                                <p class="text-sm font-medium text-slate-800 truncate">@a.Title</p>
                                <p class="text-xs text-slate-400 mt-0.5 truncate"><i class="fa-solid fa-book-open mr-1 text-slate-300"></i>@a.Module?.Course?.Title</p>
                            </div>
                            <div class="flex flex-col items-end gap-1 flex-shrink-0">
                                @if (submitted)
                                {
                                    <span class="inline-flex items-center gap-1 text-xs bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-medium">
                                        <i class="fa-solid fa-check text-xs"></i> Submitted
                                    </span>
                                }
                                else if (isOverdue)
                                {
                                    <span class="inline-flex items-center gap-1 text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded-full font-medium">
                                        <i class="fa-solid fa-circle-exclamation text-xs"></i> Overdue
                                    </span>
                                }
                                else if (isDueSoon)
                                {
                                    <span class="inline-flex items-center gap-1 text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full font-medium">
                                        <i class="fa-solid fa-fire text-xs"></i> Due soon
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-medium">
                                        <i class="fa-solid fa-hourglass-half text-xs"></i> Pending
                                    </span>
                                }
                                @if (a.DeadlineDate.HasValue)
                                {
                                    <span class="text-xs text-slate-400">
                                        <i class="fa-regular fa-calendar mr-0.5"></i>@a.DeadlineDate.Value.ToString("dd MMM yyyy")
                                    </span>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- Announcements -->
        <div class="page-card">
            <div class="flex items-center justify-between mb-5">
                <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-blue-50 flex items-center justify-center">
                        <i class="fa-solid fa-bullhorn text-blue-700 text-xs"></i>
                    </span>
                    Announcements
                </h2>
                <a asp-controller="Announcements" asp-action="Index" class="text-xs text-blue-700 hover:underline font-medium inline-flex items-center gap-1">View all <i class="fa-solid fa-arrow-right text-xs"></i></a>
            </div>
            @if (!announcements.Any())
            {
                <div class="flex flex-col items-center py-10 text-slate-300">
                    <i class="fa-solid fa-bullhorn text-4xl mb-3"></i>
                    <p class="text-sm font-medium text-slate-400">No announcements</p>
                    <p class="text-xs text-slate-300 mt-1">New announcements from your lecturers will appear here.</p>
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var an in announcements)
                    {
                        <div class="flex items-start gap-3 p-4 rounded-xl border border-slate-100 hover:border-blue-200 hover:bg-blue-50/50 transition-all">
                            <div class="w-9 h-9 rounded-xl bg-blue-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <i class="fa-solid fa-bullhorn text-blue-700 text-xs"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-slate-800 truncate">@an.Title</p>
                                <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                                    <span class="inline-flex items-center gap-1 text-xs text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded font-medium truncate max-w-[120px]">
                                        <i class="fa-solid fa-book-open text-xs"></i> @an.Course?.Title
                                    </span>
                                    <span class="text-xs text-slate-400"><i class="fa-regular fa-clock mr-0.5"></i>@an.CreatedAt.ToString("dd MMM yyyy")</span>
                                </div>
                                <p class="text-sm text-slate-600 mt-2 leading-relaxed line-clamp-2">@an.Content</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="page-card">
        <h2 class="text-sm text-slate-700 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-bolt text-blue-700"></i> Quick Actions
        </h2>
        <div class="flex flex-wrap gap-3">
            <a asp-controller="Courses" asp-action="Index"
               class="inline-flex items-center gap-2 bg-blue-700 hover:bg-blue-800 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-book-open"></i> My Courses
            </a>
            <a asp-controller="Assignments" asp-action="Index"
               class="inline-flex items-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-clipboard-list"></i> Assignments
            </a>
            <a asp-controller="AssignmentSubmissions" asp-action="MyGrades"
               class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-star"></i> My Grades
            </a>
            <a asp-controller="Announcements" asp-action="Index"
               class="inline-flex items-center gap-2 bg-slate-600 hover:bg-slate-700 text-white text-xs px-4 py-2.5 rounded-lg transition-all shadow-sm hover:shadow">
                <i class="fa-solid fa-bullhorn"></i> Announcements
            </a>
        </div>
    </div>

</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    const statusData   = [@submittedCount, @pendingCount, @overdueCount];
    const statusLabels = ['Submitted', 'Pending', 'Overdue'];
    const statusColors = ['#10b981', '#f59e0b', '#f43f5e'];

    new Chart(document.getElementById('submissionStatusChart'), {
        type: 'doughnut',
        data: {
            labels: statusLabels,
            datasets: [{
                data: statusData,
                backgroundColor: statusColors,
                borderWidth: 2,
                borderColor: '#fff',
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            cutout: '65%',
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${ctx.parsed}` } }
            }
        }
    });

    const legend = document.getElementById('submissionLegend');
    statusLabels.forEach((lbl, i) => {
        legend.innerHTML += `<span class="flex items-center gap-1 text-slate-500">
            <span style="background:${statusColors[i]}" class="inline-block w-2.5 h-2.5 rounded-full"></span>
            ${lbl}: <strong>${statusData[i]}</strong></span>`;
    });
</script>
}
